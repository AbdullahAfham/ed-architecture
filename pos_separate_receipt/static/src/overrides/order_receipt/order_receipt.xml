<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_separate_receipt.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
            <t t-if="props.data.headerData.qr_image">
                <img id="posqrcode" t-att-src="props.data.headerData.qr_image" class="pos-receipt-logo"/>
                <br />
            </t>
        </xpath>
    </t>

</templates>
