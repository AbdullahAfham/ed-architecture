<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
      <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
          <xpath expr="//field[@name='currency_id']" position="attributes">
            <attribute name="invisible">True</attribute>
            <!-- <attribute name="readonly">False</attribute> -->
          </xpath>
          <xpath expr="//field[@name='payment_term_id']" position="before">
            <field name="khr_currency_id" invisible="1"/>
            <field name="exchange_date"/>
            <field name="exchange_rate" readonly="0"/>
          </xpath>

          <xpath expr="//group//field[@name='tax_totals']" position="after">
            <field name="amount_total_khr" 
                   widget="monetary" 
                   readonly="0"
                   options="{'currency_field': 'khr_currency_id'}"
                   invisible="is_pricelist_khr != False"/>
            <field name="amount_total_usd" 
                   widget="monetary" 
                   readonly="0"
                   options="{'currency_field': 'usd_currency_id'}"
                   invisible="is_pricelist_usd != False"/>
          </xpath>

        </field>
      </record>
      
      <record id="view_sale_order_quotation_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
          <xpath expr="//field[@name='amount_total']" position="after">
            <field name="exchange_rate" optional="hide" />
            <field name="amount_total_khr" optional="show" widget="monetary" options="{'currency_field': 'khr_currency_id'}"/>
            <field name="amount_total_usd" optional="show" widget="monetary" options="{'currency_field': 'khr_currency_id'}"/>
          </xpath>
        </field>
      </record>
    </data>
</odoo>