<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_overtime_batch_req" model="ir.sequence">
            <field name="name">Batch Overtime Sequencer</field>
            <field name="code">hr.batch.overtime</field>
            <field name="prefix">BOT/%(y)s/</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field name="padding">5</field>
        </record>
    </data>
    <data>
        <!-- Views -->
        <!-- Form View -->
        <record id="hr_batch_overtime_form_view" model="ir.ui.view">
            <field name="name">Batch Overtime</field>
            <field name="model">hr.batch.overtime</field>
            <field name="arch" type="xml">
                <form string="Batch Overtime">
                    <field name="can_pm_approve" invisible="1"/>
                    <field name="can_hr_approve" invisible="1"/>
                    <field name="can_om_approve" invisible="1"/>
                    <field name="can_refuse" invisible="1"/>
                    <field name="can_reset_to_draft" invisible="1"/>
                    <field name="can_reset_to_waiting" invisible="1"/>
                    <field name="can_reset_to_pm_approval" invisible="1"/>
                    <field name="can_reset_to_hr_approval" invisible="1"/>
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approval,pm_approval,hr_approval"/>
                        <button name="submit_request" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <!-- <button name="action_check_overtime_request" string="Check Overtime" type="object" class="btn-primary" attrs="{'invisible': [('state', 'not in', ['draft','approval','pm_approval','hr_approval'])]}"/> -->
                        <button name="pm_approve" string="PM Approved" type="object" class="btn-primary" invisible="can_pm_approve != 'True'"/>
                        <button name="hr_office_approve" string="HR Validated" type="object" class="btn-primary" invisible="can_hr_approve != 'True'" />
                        <!-- <button name="om_approve" string="OM Approved" type="object" class="btn-primary" attrs="{'invisible': [('can_om_approve', '=', False)]}"/> -->
                        <button name="cancel" string="Cancel" type="object" class="btn-primary" invisible="state != 'draft'"/>
                        <button name="reject" string="Refuse" type="object" class="btn-primary" invisible="can_refuse != True"/>
                        <button name="action_draft" string="Reset to Draft" type="object" class="btn-primary" invisible="can_reset_to_draft != True" />
                        <button name="action_reset_to_waiting" string="Reset to Waiting" type="object" class="btn-primary" invisible="can_reset_to_waiting != True"/>
                        <button name="action_reset_to_pm_approval" string="Reset to PM Approval" type="object" class="btn-primary" invisible="can_reset_to_pm_approval != True"/>
                        <!-- <button name="action_reset_to_hr_approval" string="Reset to HR Approval" type="object" class="btn-primary" attrs="{'invisible': [('can_reset_to_hr_approval', '=', False)]}"/> -->
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="0" placeholder="Reference ...."/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="project_id" options="{'no_create': True}" readonly="state != 'draft'" />
                                <label for="date_from" string="Date"/>
                                <div class="w-100">
                                    <div class="o_row">
                                        <field name="date_from" widget="daterange" options="{&quot;related_end_date&quot;: &quot;date_to&quot;}" readonly="state not in ['draft','approval','pm_approval']" required="1"/>
                                        <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                                        <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow" invisible="date_from == False or date_to == False"/>
                                        <field name="date_to" widget="daterange" options="{&quot;related_start_date&quot;: &quot;date_from&quot;}" readonly="state not in ['draft','approval','pm_approval']" required="1"/>
                                    </div>
                                </div>
                                <field name="break_hours" class="oe_inline" readonly="state not in ['draft','approval','pm_approval']"/>
                                <field name="days_no_tmp" string="Hours" invisible="duration_type == 'days'"/>
                                <field name="days_no_tmp" string="Days" invisible="duration_type == 'hours'"/>
                                <field name="payslip_paid" readonly="1" invisible="1" widget="toggle_button" groups="hr.group_hr_manager"/>
                                <field name="days_no" readonly="1" invisible="1"/>
                            </group>
                            <group>
                                <field name="duration_type" readonly="state not in ['draft','approval','pm_approval']"/>
                                <field name="user_id" string="Requester" widget="many2one_avatar_user" readonly="state not in ['draft','approval','pm_approval']"/>
                                <field name="creator_id" invisible="1" widget="many2one_avatar_user" readonly="state not in ['draft','approval','pm_approval']"/>
                                <field name='approver_id' widget="many2one_avatar_user" readonly="state not in ['draft','approval','pm_approval']"/>
                                <field name='hr_officer_approver_id' widget="many2one_avatar_user" readonly="state not in ['draft','approval','pm_approval']"/>
                                <!-- <field name="om_approver_id" widget="many2one_avatar_user" readonly="state not in ['draft','approval','pm_approval']"/> -->
                                <field name='type' invisible="1" readonly="state not in ['draft','approval','pm_approval']"/>
                                <field name="current_user_boolean" invisible="1"/>
                                <!--                                <field name='overtime_type_id' groups="hr.group_hr_user" required="True"/>-->
                                
                                <!--                                <field name="cash_hrs_amount" force_save="1" attrs="{'invisible': ['|','|',('state', '=', 'draft'),('type','!=', 'cash'),('duration_type','!=','hours')]}" groups="hr.group_hr_manager,account.group_account_user"/>-->
                                <!--                                <field name="cash_day_amount" force_save="1" attrs="{'invisible': ['|','|',('state', '=', 'draft'),('type','!=', 'cash'),('duration_type','!=','days')]}" groups="hr.group_hr_manager,account.group_account_user"/>-->
                                <!--                                <separator string="Public Holiday"/>-->
                                <!--                                <field name="public_holiday" force_save="1"/>-->
                                <field name='overtime_type_id' groups="hr.group_hr_user" 
                                    readonly="state != 'pm_approval'" 
                                    invisible="state not in ['pm_approval', 'hr_approval', 'approved']"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Overtime Request">
                                <field name="overtime_ids">
                                    <list string="Overtime Request" editable="bottom">

                                        <field name="employee_id" options="{'no_create': True}"/>
                                        <field name="desc" readonly="state != 'draft'" />
                                        <!-- <field name="scan_ot_in" readonly="1" invisible="1"/>
                                        <field name="scan_ot_out" readonly="1" invisible="1"/> -->
                                        <!-- <field name="actual_duration" invisible="1"/> -->
                                        <!-- <field name='department_id' optional="hide"/> -->
                                        <!-- <field name='job_id' optional="hide"/> -->
                                        <field name="project_id" invisible="1" options="{'no_create': True}"/>
                                        <field name="date_from" invisible="1"/>
                                        <field name="date_to" invisible="1"/>
                                        <field name="days_no_tmp" sum="Total Hour"/>
                                        <!-- <field name="balance" invisible="1"/> -->
                                        <field name="cash_hrs_amount" sum="Total Amount"
                                                    readonly="state != 'officer_approval'"
                                                    invisible="state not in ['officer_approval', 'finance_approval', 'approved']"
                                                    required="state == 'officer_approval'"
                                                    groups="hr.group_hr_manager"/>
                                                    
                                        <field name="name" readonly="1" optional="hide"/>
                                        <field name="user_id" optional="hide"/>
                                        <field name="state" invisible="1"/>
                                        <field name="type" invisible="1"/>
                                        <field name="payslip_paid" groups="hr.group_hr_manager" readonly="1" invisible="type != 'cash'" widget="toggle_button" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description" name="work_description">
                                <field name="desc" readonly="state != 'draft'" />
                            </page>
                            <!--                            <page string="Work Schedule">-->
                            <!--                                <field name="work_schedule" readonly="1"/>-->
                            <!--                            </page>-->

                        </notebook>

                        <!--                        <group string="Refuse Reason"-->
                        <!-- attrs="{'invisible': [('cancel_reason', '=', False)]}">-->
                        <!--                            <field name="cancel_reason" readonly="1"/>-->
                        <!--                        </group>-->
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="hr_batch_overtime_tree_view" model="ir.ui.view">
            <field name="name">Batch Overtime</field>
            <field name="model">hr.batch.overtime</field>
            <field name="arch" type="xml">
                <list string="Batch Overtime">
                    <header>
                        <button name="approve_all" string="Approved All" type="object" class="oe_highlight ml-2" groups="hr_overtime.group_hr_overtime_manager"/>
                    </header>

                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="duration_type" invisible="1"/>
                    <field name="total_days_no_tmp" string="Total Hours"/>
                    <field name="state" widget="badge" decoration-info="state in ('draft','approval', 'pm_approval', 'hr_approval')" decoration-success="state == 'approved'" decoration-danger="state == 'refused'" decoration-muted="state == 'cancel'"/>
                    <field name="type" invisible="1"/>
                    <field name="payslip_paid" groups="hr.group_hr_manager" readonly="1" invisible="type != 'cash'" widget="toggle_button"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="hr_batch_overtime_search_view" model="ir.ui.view">
            <field name="name">Batch Overtime</field>
            <field name="model">hr.batch.overtime</field>
            <field name="arch" type="xml">
                <search>
                    <group expand="0" string="Group By">
                        <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Project" name="group_by_project_id" context="{'group_by': 'project_id'}"/>
                        <filter string="Date From" name="group_by_date_from" context="{'group_by': 'date_from'}"/>
                        <filter string="Date To" name="group_by_date_to" context="{'group_by': 'date_to'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Actions -->
        <!-- overtime -->
        <record id="hr_batch_overtime_action" model="ir.actions.act_window">
            <field name="name">Batch Overtime</field>
            <field name="res_model">hr.batch.overtime</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_by_state': 1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create new Pre Approval Overtime Request.
                </p>
            </field>
        </record>

        <!-- MenuItems -->
        <menuitem id="batch_overtime_submenu" name="Batch Overtime" 
            parent="overtime_submenu" 
            action="hr_batch_overtime_action" 
            sequence='1' 
            groups="hr_overtime.group_batch_overtime_user"/>
    </data>
</odoo>
