<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Category-->
    <record id="module_category_hr_overtime" model="ir.module.category">
        <field name="name">Overtime Request</field>
        <field name="description">Helps you manage your employees overtime.</field>
        <field name="sequence">50</field>
    </record>
    <!--    User Group-->
    <record id="group_hr_overtime_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_hr_overtime"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <!-- -->
        <field name="comment">The user will be able to create overtime</field>
    </record>
    <!--    Manager Group-->
    <record id="group_hr_overtime_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_hr_overtime"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_hr_overtime_user')])]"/>
        <field name="comment">The user will be able to approve document created by employees.</field>
    </record>

    <!--    Manager Group-->
    <record id="group_hr_overtime_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_hr_overtime"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_hr_overtime_manager')])]"/>
        <field name="comment">All records</field>
    </record>

    <!-- This group is defined to manage Batch Overtime menu -->
    <record id="group_batch_overtime_user" model="res.groups">
        <field name="name">Batch Overtime User</field>
        <field name="comment">This group is defined to manage Batch Overtime menu.</field>
    </record>

    <data>
<!--        &lt;!&ndash; Rule for Follower &ndash;&gt;-->
<!--        <record id="overtime_follwer_rule" model="ir.rule">-->
<!--            <field name="name">OT Followers</field>-->
<!--            <field name="model_id" ref="model_hr_overtime"/>-->
<!--            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id])]</field>-->
<!--        </record>-->

        <!--        Rule for User Group-->
        <record id="overtime_user_rule" model="ir.rule">
            <field name="name">Personal Overtime Request</field>
            <field name="model_id" ref="model_hr_overtime"/>
            <!-- <field name="domain_force">['|', ('user_id','=',user.id), ('submitter_ids','=',user.id)]</field> -->
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_overtime_user'))]"/>
        </record>
        <!--        <record id="overtime_user_rule" model="ir.rule">-->
        <!--            <field name="name">Overtime Request to verify</field>-->
        <!--            <field name="model_id" ref="model_hr_overtime"/>-->
        <!--            <field name="domain_force">[('project_validate_id','=',user.id)]</field>-->
        <!--            <field name="groups" eval="[(4, ref('group_hr_overtime_user'))]"/>-->
        <!--        </record>-->

        <!--        Rule for Manager Group-->
        <record id="overtime_manager_rule" model="ir.rule">
            <field name="name">Manager Overtime Request</field>
            <field name="model_id" ref="model_hr_overtime"/>
            <field name="domain_force">['|', ('user_id','=',user.id), ('project_manager_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_overtime_manager'))]"/>
        </record>

        <!--        Rule for Manager Group-->
        <record id="overtime_admin_rule" model="ir.rule">
            <field name="name">Administrator</field>
            <field name="model_id" ref="hr_overtime.model_hr_overtime"/>
            <field name="domain_force">[(1,'=',1)]</field>            <!-- -->
            <field name="groups" eval="[(4, ref('group_hr_overtime_admin'))]"/>
        </record>

        <!--        Rule for -->
        <record id="hr_overtime_comp_rule" model="ir.rule">
            <field name="name">Overtime multi company rule</field>
            <field name="model_id" ref="model_hr_overtime"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <!--        Rule for Manager Group-->
        <record id="batch_overtime_manager_rule" model="ir.rule">
            <field name="name">Manager Batch Overtime Request</field>
            <field name="model_id" ref="hr_overtime.model_hr_batch_overtime"/>
            <field name="domain_force">['|', ('user_id','=',user.id), ('approver_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_overtime_manager'))]"/>
        </record>

        <!--        Rule for Manager Group-->
        <record id="batch_overtime_admin_rule" model="ir.rule">
            <field name="name">Administrator</field>
            <field name="model_id" ref="hr_overtime.model_hr_batch_overtime"/>
            <field name="domain_force">[(1,'=',1)]</field>            <!-- -->
            <field name="groups" eval="[(4, ref('group_hr_overtime_admin'))]"/>
        </record>

        <!--        Rule for Users Group-->
        <record id="batch_overtime_user_rule" model="ir.rule">
            <field name="name">HR Batch Overtime Record Rule</field>
            <field name="model_id" ref="hr_overtime.model_hr_batch_overtime"/>
            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id])]</field>            <!-- -->
            <field name="groups" eval="[(4, ref('group_hr_overtime_user'))]"/>
        </record>

        <!--        Rule for -->
        <record id="hr_batch_overtime_comp_rule" model="ir.rule">
            <field name="name">Personal Batch Overtime Request</field>
            <field name="model_id" ref="hr_overtime.model_hr_batch_overtime"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_overtime_user'))]"/>
        </record>

<!--        &lt;!&ndash; Rule for Follower &ndash;&gt;-->
