<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_category_hr_announcement" model="ir.module.category">
        <field name="name">Announcement</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_hr_announcement_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="category_id" ref="module_category_hr_announcement" />
    </record>

    <record id="group_hr_announcement_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_hr_announcement_user'))]"/>
        <field name="category_id" ref="module_category_hr_announcement"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="hr_announcement_user_rule" model="ir.rule">
        <field name="name">HR Announcement: User</field>
        <field name="model_id" ref="model_hr_announcement" />
        <field name="groups" eval="[(6,0, [ref('group_hr_announcement_user')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="domain_force">[('create_uid','=',user.id)]</field>
    </record>

    <record id="hr_announcement_admin_rule" model="ir.rule">
        <field name="name">HR Announcement: Admin</field>
        <field name="model_id" ref="model_hr_announcement" />
        <field name="groups" eval="[(6,0, [ref('group_hr_announcement_admin')])]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

</odoo>
