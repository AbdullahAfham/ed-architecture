<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
      <template id="report_purchase_order_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout"><br/>
                    <!--Body-->
                    <div class="page">
                      <style type="text/css">
                        @font-face {
                            font-family: Moul;
                            font-style: normal;
                            src:url('/report_layout_template/static/src/fonts/KhmerOSMuolLight.ttf') format('truetype');
                        }
                        @font-face {
                            font-family: Battambang;
                            font-style: normal;
                            src:url('/report_layout_template/static/src/fonts/Battambang/Battambang-Regular.ttf') format('truetype');
                        }
                        .erp-title {
                            font-size: 20px;
                            font-family: Moul;
                            padding-bottom: 3px;
                            font-weight: bold;
                        }
                        .erp-title-en{
                            font-size: 20px;
                            font-family: 'Time';
                            padding-bottom: 3px;
                            font-weight: bold;
                        }
                        .erp-text{
                            font-size: 14px;
                            font-family: Battambang;
                            padding-bottom: 3px;
                        }
                        .erp-border{
                            border: 1px solid black;
                        }
                        .erp-table-header{
                            font-weight: bold;
                            background-color:  #7b7d7d;
                            color: #FFFFFF;
                        }
                        .erp-table-body{
                            border: 1px solid black;
                        }
                        .erp-right{
                            text-align: right;
                        }
                        .erp-center{
                            text-align: center;
                        }
                      </style>
                      
                      <div class="oe_structure"/>
                        <!--<h2 t-if="o.state in ['draft', 'sent', 'to approve']">Request for Quotation #<span t-field="o.name"/></h2>-->
                        <h4 class="text-center erp-title" style="margin-top: -85px; padding:10px;">PURCHASE ORDER</h4>
                        <h4 t-if="o.state == 'cancel'">Cancelled Purchase Order #<span t-field="o.name"/></h4>

                        <div class="row">
                          <div class="col-8">
                            <div class="row">
                              <div class="col-12">
                                <span class="erp-text">អ្នកផ្គត់ផ្គង់ / Vendor</span>
                              </div>
                            </div>
                            <div class="row" t-if="o.partner_id.khmer_name">
                              <div class="col-4">
                                <span class="erp-text">ឈ្មោះក្រុមហ៊ុន ឬអ្នកផ្គត់ផ្គង់</span>
                              </div>
                              <div class="col-8">
                                : <span class="erp-text" t-field="o.partner_id.khmer_name"/>
                              </div>
                            </div>
                            <div class="row" t-if="o.partner_id.parent_id or o.partner_id.company_type =='company'">
                              <div class="col-4">
                              <span class="erp-text">Company Name/Vendor</span>
                              </div>
                              <div class="col-8 erp-text">
                                <t t-if="o.partner_id.parent_id" class="erp-text">: <span t-field="o.partner_id.parent_id.name"/></t>
                                <t t-if="not o.partner_id.parent_id" class="erp-text">: <span t-field="o.partner_id.name"/></t>
                              </div>
                            </div>
                            <div class="row" t-if="o.partner_id.company_type =='person'">
                              <div class="col-4">
                                <span class="erp-text">Vendor</span>
                              </div>
                              <div class="col-8">
                                : <span class="erp-text" t-field="o.partner_id.name"/>
                              </div>
                            </div>
                            <div class="row" t-if="o.partner_id.khmer_address">
                              <div class="col-4">
                                <span class="erp-text">អាសយដ្ឋាន</span>
                              </div>
                              <div class="col-8 erp-text" t-options="{'widget': 'text'}">
                                : <span><t t-if="o.partner_id.street"><span t-esc="o.partner_id.khmer_address"/></t></span>
                              </div>
                            </div>
                            <div class="row" t-if="o.partner_id.street">
                              <div class="col-4">
                                <span class="erp-text">Address</span>
                              </div>
                              <div class="col-8 erp-text" t-options="{'widget': 'text'}">
                                : <span><t t-if="o.partner_id.street"><span t-esc="o.partner_id.street"/>,</t>
                                  <t t-if="o.partner_id.street2"><span t-esc="o.partner_id.street2"/>,</t>
                                  <t t-if="o.partner_id.city"><span t-esc="o.partner_id.city"/>,</t>
                                  <t t-if="o.partner_id.country_id.name"><span t-esc="o.partner_id.country_id.name"/></t></span>
                              </div>
                            </div>
                            <div class="row" t-if="o.partner_id.phone">
                              <div class="col-4">
                                <span class="erp-text">ទូរស័ព្ទលេខ</span>
                              </div>
                              <div class="col-8 erp-text">
                                : <span><t t-if="o.partner_id.phone"><span t-esc="o.partner_id.phone"/></t></span>
                              </div>
                            </div>
                            <div class="row" t-if="o.partner_id.phone">
                              <div class="col-4">
                                <span class="erp-text">Telephone</span>
                              </div>
                              <div class="col-8 erp-text">
                                : <span><t t-if="o.partner_id.phone"><span t-esc="o.partner_id.phone"/></t></span>
                              </div>
                            </div>

                            <div class="row" t-if="o.partner_id.vat">
                              <div class="col-4">
                                <span class="erp-text">VAT No.</span>
                              </div>
                              <div class="col-8">
                                : <span class="erp-text" t-field="o.partner_id.vat"/>
                              </div>
                            </div>
                            <div class="row" t-if="o.payment_term_id">
                              <div class="col-4">
                                <span class="erp-text">Payment Term</span>
                              </div>
                              <div class="col-8">
                                : <span class="erp-text" t-field="o.payment_term_id.name"/>
                              </div>
                            </div>
                          </div>

                          <div class="col-4">
                            <div class="row">
                              <div class="col-6">
                                <span class="erp-text">លេខប័ណ្ណ</span>
                              </div>
                              <div class="col-6">
                                : <span class="erp-text" t-field="o.name"/>
                              </div>
                            </div>                               
                            <div class="row" t-if="o.date_order">
                              <div class="col-6">
                                <span class="erp-text">កាលបរិច្ឆេទ/Date</span>
                              </div>
                              <div class="col-6">
                                : <span class="erp-text" t-field="o.date_order" t-options="{'widget': 'date'}"/>
                              </div>
                            </div>                                
                          </div>
                        </div>
                        <br/>                        

                        <table class="table table-sm o_main_table erp-border">
                            <thead class="erp-border">                                  
                                <tr class="erp-border border-black">
                                    <th class="erp-text text-center erp-border"><strong>No</strong></th>
                                    <!-- <th class="erp-text erp-border"><strong>Item Code</strong></th> -->
                                    <th class="erp-text text-center erp-border" name="th_description"><strong>Description</strong></th>
                                    <!--<th name="th_taxes"><strong>Taxes</strong></th>-->
                                    <!--<th name="th_date_req" class="text-center"><strong>Date Req.</strong></th>-->
                                    <th name="th_quantity" class="text-center erp-text erp-border"><strong>Qty</strong></th>
                                    <th name="th_uom" class="text-center erp-text erp-border"><strong>UoM</strong></th>
                                    <th name="th_price_unit" class="text-center erp-text erp-border"><strong>Unit Price</strong></th>
                                    <!-- <th name="th_discount" class="text-center erp-text-bold erp-border"><span>Disc.%</span></th>        -->
                                    <th name="th_amount" class="text-center erp-text erp-border"><strong>Amount</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                              <t t-set="current_subtotal" t-value="0"/>
                              <t t-set="no" t-value="0"/>
                              <t t-foreach="o.order_line" t-as="line">
                                  <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                  <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                  <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else 'border-black'">
                                      <t t-if="not line.display_type">
                                          <t t-set="no" t-value="no+1"/>
                                          <td class="text-center erp-text erp-border">
                                              <span t-esc="no"/>
                                          </td>
                                          <!-- <td class="text-center erp-text erp-border" style="font-size:12px">
                                              <span t-field="line.product_id.default_code"/>
                                          </td> -->
                                          <td id="product" class="text-left erp-text erp-border">
                                              <span t-field="line.name"/>
                                          </td>
                                          <!--<td name="td_taxes">-->
                                          <!--    <span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))"/>-->
                                          <!--</td>-->
                                          <!--<td class="text-center">-->
                                          <!--    <span t-field="line.date_planned"/>-->
                                          <!--</td>-->
                                          <td class="text-center erp-text erp-border">
                                              <span t-field="line.product_qty"/>
                                              <!-- <span t-field="line.product_uom.name" groups="uom.group_uom"/> -->
                                          </td>
                                          <td class="text-center erp-text erp-border">
                                              <!-- <span t-field="line.product_qty"/> -->
                                              <span t-field="line.product_uom.name" groups="uom.group_uom"/>
                                          </td>
                                          <td class="text-center erp-text erp-border">
                                              <span t-if="o.currency_id.name == 'KHR'" t-esc="'{:,.2f}'.format(line.price_unit * o.exchange_rate)"/>
                                              <span t-if="o.currency_id.name != 'KHR'" t-field="line.price_unit"/>
                                          </td>
                                          <!-- <td class="text-center erp-text erp-border" t-if="line.discount">
                                              <span t-field="line.discount"/>
                                          </td>                                               -->
                                          <td class="text-end erp-text erp-border">
                                              <!-- <span t-esc="'{:,.2f}'.format(line.price_subtotal)" /> -->
                                              <span t-if="o.currency_id.name == 'KHR'" t-esc="'{:,.2f}'.format(line.price_subtotal * o.exchange_rate)"/>
                                              <span t-if="o.currency_id.name != 'KHR'" t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                                          </td>
                                      </t>
                                      <t t-if="line.display_type == 'line_section'">
                                          <td colspan="99" id="section" class="erp-text erp-border">
                                              <span t-field="line.name"/>
                                          </td>
                                          <t t-set="current_section" t-value="line"/>
                                          <t t-set="current_subtotal" t-value="0"/>
                                      </t>
                                      <t t-if="line.display_type == 'line_note'">
                                          <td colspan="99" id="note" class="erp-text erp-border">
                                              <span t-field="line.name"/>
                                          </td>
                                      </t>
                                  </tr>
                                </t>

                                <!-- === if currency_id == USD then display this === -->
                                <t t-if="o.currency_id.name == 'USD'">
                                    <tr class="erp-text erp-border border-black">                                        
                                        <th t-if="not line.discount" colspan="5" class="text-end erp-border"><span>សរុប - Subtotal</span></th>
                                        <th t-if="line.discount" colspan="6" class="text-end erp-border"><span>សរុប - Subtotal</span></th>                                        
                                        <th class="erp-text text-end erp-border">
                                            <span t-field="o.amount_untaxed"/>
                                        </th>
                                    </tr>                                    
                                    <tr class="erp-text erp-border border-black" t-if="o.amount_tax">
                                          <th t-if="not line.discount" colspan="5" class="text-end erp-border"><span>អាករលើតម្លៃបន្ថែម - VAT 10% (USD)</span></th>
                                          <th class="erp-text text-end erp-border">
                                              <span t-field="o.amount_tax"/>
                                          </th>
                                      </tr>

                                    <tr class="erp-text erp-border border-black">
                                        <th t-if="not line.discount" colspan="5" class="text-end erp-border"><span>សរុបរួមជាដុល្លារ - Grand Total in USD</span></th>
                                        <th class="erp-text text-end erp-border">
                                            <span t-field="o.amount_total"/>
                                        </th>
                                    </tr>
                                    <tr class="erp-text erp-border border-black">
                                        <th t-attf-colspan="{{ '6' if line.discount else '5' }}" class="text-end erp-border">
                                            <span>សរុបរួមជាប្រាក់រៀល - Total in KHR</span>
                                        </th>
                                        <th class="erp-text text-end erp-border">
                                            <span t-esc="o.amount_total_khr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.khr_currency_id}"/>
                                        </th>
                                    </tr>
                                </t>
                                <!-- === end === -->

                                <!-- === if currency_id == KHR then convert the value from USD to riel by * o.exchange_rate === -->
                                <t t-if="o.currency_id.name == 'KHR'">
                                    <tr class="erp-text erp-border border-black">                                        
                                        <th t-if="not line.discount" colspan="5" class="text-end erp-border"><span>សរុប - Subtotal</span></th>
                                        <th t-if="line.discount" colspan="6" class="text-end erp-border"><span>សរុប - Subtotal</span></th>                                        
                                        <th class="erp-text text-end erp-border">
                                            <span t-esc="o.amount_untaxed * o.exchange_rate" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </th>
                                    </tr>                                    
                                    <tr class="erp-text erp-border border-black">
                                        <th t-if="not line.discount" colspan="5" class="text-end erp-border"><span>អាករលើតម្លៃបន្ថែម - VAT 10% (Riel)</span></th>
                                        <th t-if="line.discount" colspan="6" class="text-end erp-border"><span>អាករលើតម្លៃបន្ថែម - VAT 10% (Riel)</span></th>
                                        <th class="erp-text text-end erp-border">
                                            <span t-esc="o.amount_tax * o.exchange_rate" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </th>
                                    </tr>

                                    <tr class="erp-text erp-border border-black">
                                        <th t-if="not line.discount" colspan="5" class="text-end erp-border"><span>សរុបរួមជាប្រាក់រៀល - Grand Total in Riel</span></th>
                                        <th t-if="line.discount" colspan="6" class="text-end erp-border"><span>សរុបរួមជាប្រាក់រៀល - Grand Total in Riel</span></th>
                                        <th class="erp-text text-end erp-border">
                                            <span t-esc="o.amount_total * o.exchange_rate" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </th>
                                    </tr>
                                </t>
                                <!-- === end === -->

                                <!-- === Subtotal section === -->
                                <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                                    <tr class="is-subtotal text-right erp-text erp-broder">
                                        <td colspan="99" id="subtotal">
                                            <strong class="mr16">Subtotal</strong>
                                            <span t-if="o.currency_id.name == 'USD'" t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            <span t-if="o.currency_id.name == 'KHR'" t-esc="current_subtotal * o.exchange_rate" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                                <!-- === end === -->
                            </tbody>
                        </table>

                        <!--<div id="total" class="row justify-content-end">-->
                        <!--    <div class="col-4">-->
                        <!--        <table class="table table-sm">-->
                        <!--            <t t-set="tax_totals" t-value="json.loads(o.tax_totals_json)"/>-->
                        <!--            <t t-call="account.document_tax_totals"/>-->
                        <!--        </table>-->
                        <!--    </div>-->
                        <!--</div>-->

                        <!-- <strong>Remark: </strong><p t-field="o.notes" class="erp-text"/> -->

                        <div class="row" style="margin-top: 15px; page-break-inside: avoid;">
                            <div class="col-5">
                                <div style="color: white;" class="erp-text text-center">-</div>
                                <div style="border-bottom: 1px solid black; margin-top: 140px; margin-bottom: 5px;"/>
                                <div class="erp-text text-center">ហត្ថលេខា និងឈ្មោះអ្នកទិញ
                                </div>
                                <div class="erp-text text-center">Customer's Authorized Signature and Name</div>
                            </div>
                            <div class="col-2">
                                <div style="color: white;" class="erp-text text-center">-</div>
                                <div style="border-bottom: ០px solid black; margin-top: 100px; margin-bottom: 5px;"/>
                            </div>
                            <div class="col-5">
                                <div style="color: white;" class="erp-text text-center">-</div>
                                <div style="border-bottom: 1px solid black; margin-top: 140px; margin-bottom: 5px;"/>
                                <div class="erp-text text-center">ហត្ថលេខា និងឈ្មោះអ្នកលក់ </div>
                                <div class="erp-text text-center">Seller's Authorized Signature and Name</div>

                            </div>
                        </div>

                        <div class="oe_structure"/>
                      </div>
                </t>
            </t>
        </t>
      </template>
  </data>
</odoo>