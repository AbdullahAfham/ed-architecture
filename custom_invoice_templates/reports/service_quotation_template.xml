                                    <t t-set="current_subtotal" t-value="0"/>

                                    <t t-foreach="lines_to_report" t-as="line">
                                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                                        <tr t-att-class="'fw-bold o_line_section' if (line.display_type == 'line_section'or line.product_type == 'combo') else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                            <t t-set="no" t-value="no+1"/>
                                                <td class="text-center erp-text erp-border">
                                                    <span t-esc="no"/>
                                                </td>
                                            <t t-if="not line.display_type and line.product_type != 'combo'">
                                                <td name="td_name" class="text-start erp-text erp-border"><span t-field="line.name"/></td>
                                                <td name="td_quantity" class="text-center erp-text erp-border">
                                                    <span t-field="line.product_uom_qty"/>
                                                    
                                                    <span t-if="line.product_packaging_id">
                                                        (<span t-field="line.product_packaging_qty" t-options="{&quot;widget&quot;: &quot;integer&quot;}"/> <span t-field="line.product_packaging_id"/>)
                                                    </span>
                                                </td>
                                                <td name="td_uom" class="text-center erp-text erp-border">
                                                    <span t-field="line.product_uom"/>
                                                </td>
                                                <td name="td_priceunit" class="text-center erp-text erp-border">
                                                    $ <span t-field="line.price_unit"/>
                                                </td>
                                                <td t-if="display_discount" class="text-center erp-text erp-border">
                                                    <span t-field="line.discount">-</span>
                                                </td>
                                                <!-- <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end o_price_total">
                                                    <span t-field="line.price_subtotal"></span>
                                                </td> -->
                                                <!-- <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
                                                <td name="td_taxes" t-attf-class="text-end {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                                    <span t-out="taxes"></span>
                                                </td> -->
                                                <td t-if="not line.is_downpayment" name="td_subtotal" class="text-end erp-text erp-border">
                                                    <span t-field="line.price_subtotal"/>
                                                </td>
                                            </t>
                                            <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                                                <td name="td_section_line" colspan="99">
                                                    <span t-field="line.name"/>
                                                </td>
                                                    <t t-set="current_section" t-value="line"/>
                                                <t t-set="current_subtotal" t-value="0"/>
                                            </t>
                                            <t t-elif="line.display_type == 'line_note'">
                                                <td name="td_note_line" colspan="99">
                                                    <span t-field="line.name">A note, whose content usually applies to the section or product above.</span>
                                                </td>
                                            </t>
                                        </tr>

                                        <t t-if="current_section and (line_last or lines_to_report[line_index+1].display_type == 'line_section' or lines_to_report[line_index+1].product_type == 'combo' or (line.combo_item_id and not lines_to_report[line_index+1].combo_item_id)) and not line.is_downpayment">
                                           <t t-set="current_section" t-value="None"/>
                                           <tr class="is-subtotal text-end">
                                               <td name="td_section_subtotal" colspan="99">
                                                   <strong class="mr16">Subtotal</strong>
                                                   <span t-out="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}">31.05</span>
                                               </td>
                                           </tr>
                                        </t>
                                    </t>
                                    
                                    <tr class="erp-text erp-border border-black">                                        
                                        <th t-if="not line.discount" colspan="5" class="text-end erp-border"><span>សរុប - Subtotal</span></th>
                                        <th t-if="line.discount" colspan="6" class="text-end erp-border"><span>សរុប - Subtotal</span></th>                                        
                                        <th class="erp-text text-end erp-border">
                                            <span t-field="doc.amount_untaxed"/>
                                        </th>
                                    </tr>
                                    
                                    <tr class="erp-text erp-border border-black">
                                        <th t-if="not line.discount" colspan="5" class="text-end erp-border"><span>អាករលើតម្លៃបន្ថែម - VAT 10% (USD)</span></th>
                                        <th t-if="line.discount" colspan="6" class="text-end erp-border"><span>អាករលើតម្លៃបន្ថែម - VAT 10% (USD)</span></th>
                                        <th class="erp-text text-end erp-border">
                                            <span t-field="doc.amount_tax"/>
                                        </th>
                                    </tr>

                                    <tr class="erp-text erp-border border-black">
                                        <th t-if="not line.discount" colspan="5" class="text-end erp-border"><span>សរុបរួមជាដុល្លារ - Grand Total in USD</span></th>
                                        <th t-if="line.discount" colspan="6" class="text-end erp-border"><span>សរុបរួមជាដុល្លារ - Grand Total in USD</span></th>
                                        <th class="erp-text text-end erp-border">
                                            <span t-field="doc.amount_total"/>
                                        </th>
                                    </tr>
                                </tbody>                                
                            </table>
                            
                            <div class="row" style="padding-top:20px">
                                <div class="col-8 text-start erp-text">
                                    <span><strong>Terms &amp; Conditions</strong></span><br/>
                                    <span>1. Minimum contract term is 24 months. After the initial contract expired,the circuit will be on month to month
                                        term and the termination notice is 30 days.<br/></span>
                                    <span>2. Pricing is in US Dollars</span><br/>
                                    <span>3. The Service charge is prepaid, required to pay after received the invoice 7 working days.</span><br/>
                                    <span>4. Standard installation lead time: 7 - 10 days</span><br/>
                                    <span>5. Price Validity is 30 days from the date of the offer</span>
                                    
                                </div>
                                <div class="col-4" style="padding-bottom: 30px"/>
                            </div>

                            <div class="row" style="margin-top: 15px; page-break-inside: avoid;">
                                <div class="col-4">
                                    <div style="color: white;" class="erp-text text-center">-</div>
                                    <div style="border-bottom: 1px solid black; margin-top: 140px; margin-bottom: 5px;"/>
                                    <div class="erp-text text-center">ហត្ថលេខា និងឈ្មោះអ្នកទិញ
                                    </div>
                                    <div class="erp-text text-center">Customer's Signature and Name</div>
                                </div>
                                <div class="col-4">
                                    <div style="color: white;" class="erp-text text-center">-</div>
                                    <div style="border-bottom: ០px solid black; margin-top: 100px; margin-bottom: 5px;"/>
                                </div>
                                <div class="col-4">
                                    <div style="color: white;" class="erp-text text-center">-</div>
                                    <div style="border-bottom: 1px solid black; margin-top: 140px; margin-bottom: 5px;"/>
                                    <div class="erp-text text-center">ហត្ថលេខា និងឈ្មោះអ្នកលក់ </div>
                                    <div class="erp-text text-center">Seller's Signature and Name</div>

                                </div>
                            </div>
                            <br/>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
