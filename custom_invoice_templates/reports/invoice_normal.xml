<?xml version="1.0"?>
<t t-name="account.report_invoice_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="report_layout_template.external_layout_erp_cambodia_no_head">
                        <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                        <div class="page">
                            <style type="text/css">
                                @font-face {
                                    font-family: Moul;
                                    font-style: normal;
                                    src:url('/report_layout_template/static/src/fonts/KhmerOSMuolLight.ttf') format('truetype');
                                }
                                @font-face {
                                    font-family: Battambang;
                                    font-style: normal;
                                    src:url('/report_layout_template/static/src/fonts/Battambang/Battambang-Regular.ttf') format('truetype');
                                }
                                .erp-title {
                                    font-size: 20px;
                                    font-family: Moul;
                                    padding-bottom: 3px;
                                    font-weight: bold;
                                }
                                .erp-title-en{
                                    font-size: 20px;
                                    font-family: 'Time';
                                    padding-bottom: 3px;
                                    font-weight: bold;
                                }
                                .erp-text{
                                    font-size: 14px;
                                    font-family: Battambang;
                                    padding-bottom: 3px;
                                }
                                .erp-border{
                                    border: 1px solid black;
                                }
                                .erp-table-header{
                                    font-weight: bold;
                                    background-color:  #7b7d7d;
                                    color: #FFFFFF;
                                }
                                .erp-table-body{
                                    border: 1px solid black;
                                }
                                .erp-right{
                                    text-align: right;
                                }
                                .erp-center{
                                    text-align: center;
                                }
                            </style>

                            <h4 class="text-center erp-title-en">
                                <span>INVOICE</span>
                            </h4>

                            <div class="row">
                                <div class="col-12">
                                    <div class="erp-text">
                                        <strong><span>Customer</span></strong>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-7">

                                    <div class="row">
                                        <div class="col-4">
                                            <div class="erp-text">Company</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.partner_id.name"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                      <div class="col-4">
                                        <div class="erp-text"><span>Address</span></div>
                                      </div>
                                      <div class="col-8">
                                          <div class="erp-text">
                                              : <t t-if="o.partner_id.street"><span t-esc="o.partner_id.street"/>,</t>
                                                <t t-if="o.partner_id.street2"><span t-esc="o.partner_id.street2"/>,</t>
                                                <t t-if="o.partner_id.city"><span t-esc="o.partner_id.city"/>,</t>
                                                <t t-if="o.partner_id.country_id.name"><span t-esc="o.partner_id.country_id.name"/></t>
                                          </div>
                                      </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-4">
                                            <div class="erp-text">Phone</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.partner_id.phone"/>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="col-5">
                                    <div class="row">
                                        <div class="col-7">
                                            <div class="erp-text">InvoiceNo</div>
                                        </div>
                                        <div class="col-5">
                                            <div class="erp-text">:
                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                                    <span t-if="o.name != '/'" t-field="o.name"/>
                                                </span>
                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft
                                                    Invoice
                                                </span>
                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                                    Cancelled Invoice
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-7">
                                            <div class="erp-text">Date</div>
                                        </div>
                                        <div class="col-7">
                                            <div class="erp-text">
                                                : <span t-esc="o.invoice_date" t-options="{'widget': 'date'}"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-7">
                                            <div class="erp-text">Quote Ref</div>
                                        </div>
                                        <div class="col-5">
                                            <div class="erp-text">
                                                : <span t-esc="o.invoice_origin"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-7">
                                            <div class="erp-text">Due Date</div>
                                        </div>
                                        <div class="col-5">
                                            <div class="erp-text">
                                                : <span t-esc="o.invoice_date_due" t-options="{'widget': 'date'}"/>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <br/>
                            <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>

                            <table class="table table-sm o_main_table" name="invoice_line_table">
                                <thead>
                                    <tr class="erp-border">
                                        <th name="th_description" class="text-center erp-text erp-border erp-table-header" style="width: 5%"><span>No</span></th>
                                        <th name="th_description" class="text-center erp-text erp-border erp-table-header" style="width: 50%"><span>Description</span></th>
                                        <th name="th_description" class="text-center erp-text erp-border erp-table-header" style="width: 10%"><span>Account ID</span></th>
                                        <th name="th_quantity" class="text-center erp-text erp-border erp-table-header" style="width: 10%"><span>Quantity</span></th>
                                        <th name="th_price_unit" class="text-center erp-text erp-border erp-table-header" style="width: 10%"><span>Unit Price</span></th>
                                        <th name="th_subtotal" class="text-center erp-text erp-border erp-table-header" style="width: 15%">
                                            <span>Amount</span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody class="invoice_tbody">
                                    <t t-set="no" t-value="0"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                                    <t t-foreach="lines" t-as="line">
                                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                        <tr t-att-class="'font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else 'border-black'">
                                            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                                <t t-set="no" t-value="no+1"/>
                                                <td class="text-center erp-text erp-border">
                                                    <span t-esc="no"/>
                                                </td>
                                                <td name="account_invoice_line_name" class="text-left erp-text erp-border">
                                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                </td>
                                                <td name="account_invoice_line_name" class="text-left erp-text erp-border">
                                                    <span/>
                                                </td>
                                                <td class="erp-center erp-text erp-border">
                                                    <span t-field="line.quantity"/>
                                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                                </td>
                                                <td t-attf-class="erp-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} erp-text erp-border">
                                                    <span class="text-nowrap" t-field="line.price_unit"/>
                                                </td>
                                                <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} erp-text erp-border">
                                                    <span class="text-nowrap" t-field="line.discount"/>
                                                </td>
                                                <td class="erp-right o_price_total erp-text erp-border">
                                                    <span class="text-nowrap" t-field="line.price_subtotal"/>
                                                </td>
                                            </t>
                                            <t t-if="line.display_type == 'line_section'">
                                                <td class="erp-text erp-border" colspan="99">
                                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                </td>
                                                <t t-set="current_section" t-value="line"/>
                                                <t t-set="current_subtotal" t-value="0"/>
                                            </t>
                                            <t t-if="line.display_type == 'line_note'">
                                                <td class="erp-text erp-border" colspan="99">
                                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                </td>
                                            </t>
                                        </tr>

                                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                            <tr class="is-subtotal text-right erp-text erp-border">
                                                <td colspan="99">
                                                    <strong class="mr16">Subtotal</strong>
                                                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-set="amount_total_khr" t-value="0.0"/>
                                    <t t-set="amount_total_khr" t-value="round(o.amount_total*o.exchange_rate,2)"/>

                                    <t t-set="amount_tax_khr" t-value="0.0"/>
                                    <t t-set="amount_tax_khr" t-value="round(amount_total_khr/1.1*0.1,0)"/>

                                    <t t-set="amount_untaxed_khr" t-value="0.0"/>
                                    <t t-set="amount_untaxed_khr" t-value="round(amount_total_khr-amount_tax_khr,0)"/>

                                    <tr class="erp-border border-black">
                                        <th colspan="5" class="erp-text text-end erp-border">
                                            <span>Grand Total</span>
                                        </th>
                                        <th class="erp-text text-end erp-border">
                                            <span t-field="o.amount_total"/>
                                        </th>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- Bank Information-->
                            <div class="row">
                                <div class="col-9">
                                    <div class="erp-text">
                                        <span>Bank Information for remittance of payment:
                                        </span>
                                    </div>
                                    <br/>
                                    <div>
                                        <div class="erp-text">
                                            <strong>Bank Name: ADVANCED BANK OF ASIA LIMITED (ABA Bank)</strong>
                                        </div>
                                        <div class="erp-text">SWIFT Code : ABAAKHPP</div>
                                        <div class="erp-text">Beneficiary Account Name : EMPIRE TECH CO LTD</div>
                                        <div class="erp-text">Beneficiary Account : 000 501 844</div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div style="text-align: center;">
                                        <img class="img img-responsive" t-att-src="'/custom_invoice_templates/static/img/qr_code.png'" height="185" width="185"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row" style="margin-top: 15px; page-break-inside: avoid;">
                                <div class="col-4">
                                    <div style="color: white;" class="erp-text text-center">-</div>
                                    <div style="border-bottom: 1px solid black; margin-top: 140px; margin-bottom: 5px;"/>
                                    <div class="erp-text text-center">Customer's Signature and Name</div>
                                </div>
                                <div class="col-4">
                                    <div style="color: white;" class="erp-text text-center">-</div>
                                    <div style="border-bottom: ០px solid black; margin-top: 100px; margin-bottom: 5px;"/>
                                </div>
                                <div class="col-4">
                                    <div style="color: white;" class="erp-text text-center">-</div>
                                    <div style="border-bottom: 1px solid black; margin-top: 140px; margin-bottom: 5px;"/>
                                    <div class="erp-text text-center">Seller's Signature and Name</div>
                                </div>
                            </div>
                            <br/>
                        </div>
                    </t>
                </t>
            </t>
        </t>