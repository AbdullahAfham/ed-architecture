        <!-- QWeb Reports -->

        <!-- Tax Invoice -->
        <record id="account_invoices_tax" model="ir.actions.report">
            <field name="name">TAX INVOICE</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_invoice_templates.report_invoice_tax</field>
            <field name="report_file">custom_invoice_templates.report_invoice_tax</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="attachment">(object.state == 'posted') and ((object.name or 'TAX_INV').replace('/','_')+'.pdf')</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="groups_id" eval="[(4, ref('account.group_account_invoice')),
 (4, ref('account.group_account_readonly'))]"/>
        </record>


