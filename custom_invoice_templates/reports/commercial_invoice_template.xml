<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Commercial -->
        <template id="report_invoice_commercial">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                        <div class="page">
                            <style type="text/css">
                                @font-face {
                                    font-family: Moul;
                                    font-style: normal;
                                    src:url('/report_layout_template/static/src/fonts/KhmerOSMuolLight.ttf') format('truetype');
                                }
                                @font-face {
                                    font-family: Battambang;
                                    font-style: normal;
                                    src:url('/report_layout_template/static/src/fonts/Battambang/Battambang-Regular.ttf') format('truetype');
                                }
                                .erp-title {
                                    font-size: 20px;
                                    font-family: Moul;
                                    padding-bottom: 3px;
                                    font-weight: bold;
                                }
                                .erp-title-en{
                                    font-size: 20px;
                                    font-family: 'Time';
                                    padding-bottom: 3px;
                                    font-weight: bold;
                                }
                                .erp-text{
                                    font-size: 14px;
                                    font-family: Battambang;
                                    padding-bottom: 3px;
                                }
                                .erp-border{
                                    border: 1px solid black;
                                }
                                .erp-table-header{
                                    font-weight: bold;
                                    background-color:  #7b7d7d;
                                    color: #FFFFFF;
                                }
                                .erp-table-body{
                                    border: 1px solid black;
                                }
                                .erp-right{
                                    text-align: right;
                                }
                                .erp-center{
                                    text-align: center;
                                }
                            </style>
                            <h4 class="text-center erp-title" style="padding-top:10px; margin-top:-54px;">
                                <span>វិក្កយបត្រ</span>
                            </h4>
                            <h4 class="text-center erp-title-en">
                                <span>INVOICE</span>
                            </h4>

                            <div class="row">
                                <div class="col-7">
                                    <div class="row" t-if="not o.partner_id.is_company">
                                        <div class="col-4">
                                            <div class="erp-text">
                                                <span>អតិថិជន/Customer</span>
                                            </div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.partner_id.name"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" t-if="o.partner_id.is_company or o.partner_id.parent_id">
                                        <div class="col-4">
                                            <div class="erp-text">
                                                <span>ឈ្មោះក្រុមហ៊ុន</span>
                                            </div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text" t-if="o.partner_id.parent_id">
                                                : <span t-esc="o.partner_id.parent_id.khmer_name"/>
                                            </div>
                                             <div class="erp-text" t-else="not o.partner_id.parent_id">
                                                : <span t-esc="o.partner_id.khmer_name"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" t-if="o.partner_id.is_company or o.partner_id.parent_id">
                                        <div class="col-4">
                                            <div class="erp-text">Company</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text" t-if="o.partner_id.parent_id">
                                                : <span t-esc="o.partner_id.parent_id.name"/>
                                            </div>
                                            <div class="erp-text" t-else="not o.partner_id.parent_id">
                                                : <span t-esc="o.partner_id.name"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-4">
                                            <div class="erp-text">អាសយដ្ឋាន</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.partner_id.khmer_address"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                      <div class="col-4">
                                        <div class="erp-text"><span>Address</span></div>
                                      </div>
                                      <div class="col-8">
                                          <div class="erp-text">
                                              : <t t-if="o.partner_id.street"><span t-esc="o.partner_id.street"/>,</t>
                                                <t t-if="o.partner_id.street2"><span t-esc="o.partner_id.street2"/>,</t>
                                                <t t-if="o.partner_id.city"><span t-esc="o.partner_id.city"/>,</t>
                                                <t t-if="o.partner_id.country_id.name"><span t-esc="o.partner_id.country_id.name"/></t>
                                          </div>
                                      </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-4">
                                            <div class="erp-text">លេខទូរស័ព្ទ/Phone</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.partner_id.phone"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" t-if="o.attend_id">
                                        <div class="col-4">
                                            <div class="erp-text">ទំនាក់ទំនង/Attn</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.attend_id.name"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" t-if="o.attend_id">
                                        <div class="col-4">
                                            <div class="erp-text">Tel</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.attend_id.phone"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-4">
                                            <div class="erp-text">អ៊ីមែល/Email</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.partner_id.email"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" t-if="o.partner_id.vat">
                                        <div class="col-4">
                                            <div class="erp-text">លេខ អ.ត.ប/(VATTIN)</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.partner_id.vat"/>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-5">
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="erp-text">លេខវិក្កយបត្រ/InvoiceNo</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="erp-text">:
                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                                    <span t-if="o.name != '/'" t-field="o.name"/>
                                                </span>
                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft
                                                    Invoice
                                                </span>
                                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">
                                                    Cancelled Invoice
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="erp-text">កាលបរិច្ឆេទ/Date</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="erp-text">
                                                : <span t-esc="o.invoice_date" t-options="{'widget': 'date'}"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" t-if="o.invoice_origin">
                                        <div class="col-6">
                                            <div class="erp-text">លេខយោង/Quote Ref</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="erp-text">
                                                : <span t-esc="o.invoice_origin"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-6">
                                            <div class="erp-text">ថ្ងៃផុតកំណត់/Due Date</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="erp-text">
                                                : <span t-esc="o.invoice_date_due" t-options="{'widget': 'date'}"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="erp-text">អ្នកលក់/Salesperson</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="erp-text">
                                                : <span t-if="o.invoice_sale_represent_id" t-esc="o.invoice_sale_represent_id.name"/>
                                                <span t-elif="not o.invoice_sale_represent_id" t-esc="o.invoice_user_id.name"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="erp-text">អត្រាប្ដូរប្រាក់/Exchange Rate</div>
                                        </div>
                                        <div class="col-6">
                                            <div class="erp-text">
                                                : <span t-field="o.exchange_rate" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.khr_currency_id}"/>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <br/>
                            <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>

                            <table class="table table-sm o_main_table" name="invoice_line_table">
                                <thead>
                                    <tr class="erp-border">
                                        <th name="th_no" class="text-center erp-text erp-border erp-table-header" style="width: 5%"><span>ល.រ<br/>No</span></th>
                                        <th name="th_description" class="text-center erp-text erp-border erp-table-header" style="width: 50%"><span>បរិយាយមុខទំនិញ <br/>Description</span></th>
                                        <th name="th_quantity" class="text-center erp-text erp-border erp-table-header" style="width: 10%"><span>បរិមាណ <br/>QTY</span></th>
                                        <th name="th_quantity" class="text-center erp-text erp-border erp-table-header" style="width: 10%"><span>ខ្នាត <br/>OuM</span></th>
                                        <th name="th_price_unit" class="text-center erp-text erp-border erp-table-header" style="width: 10%"><span>ថ្លៃឯកតា<br/>Unit Price</span></th>
                                        <th name="th_discount" t-if="display_discount" class="text-center erp-text erp-border erp-table-header"><span>បញ្ចុះតម្លៃ <br/>Disc.%</span></th>      
                                        <th name="th_subtotal" class="text-center erp-text erp-border erp-table-header" style="width: 15%"><span>ថ្លៃទំនិញ <br/>Amount</span></th>
                                    </tr>
                                </thead>
                                <tbody class="invoice_tbody">
                                    <t t-set="no" t-value="0"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                                    <t t-foreach="lines" t-as="line">
                                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                        <tr t-att-class="'font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else 'border-black'">
                                            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                                <t t-set="no" t-value="no+1"/>
                                                <td class="text-center erp-text erp-border">
                                                    <span t-esc="no"/>
                                                </td>
                                                <td name="account_invoice_line_name" class="text-left erp-text erp-border">
                                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                </td>
                                                <!-- <td name="account_invoice_line_name" class="text-left erp-text erp-border">
                                                    <span/>
                                                </td>
                                                <td class="erp-center erp-text erp-border">
                                                    <span t-field="line.quantity"/>
                                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                                </td> -->

                                                <td class="erp-center erp-text erp-border">
                                                    <span t-field="line.quantity"/>
                                                </td>
                                                <td class="erp-center erp-text erp-border">
                                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                                </td>
                                                <td t-attf-class="erp-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} erp-text erp-border">
                                                    <span class="text-nowrap" t-field="line.price_unit"/>
                                                    <!-- <span class="text-nowrap" t-if="o.currency_id.name == 'USD'" t-esc="'{:,.2f}'.format(line.price_unit)"/>
                                                    <span class="text-nowrap" t-elif="o.currency_id.name == 'KHR'" t-esc="'{:,.2f}'.format(round(line.price_unit * o.exchange_rate, 2))"/> -->
                                                </td>
                                                <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} erp-text erp-border">
                                                    <span class="text-nowrap" t-field="line.discount"/>
                                                </td>
                                                <td class="erp-right o_price_total erp-text erp-border">
                                                    <span class="text-nowrap" t-field="line.price_subtotal"/>
                                                    <!-- <span class="text-nowrap" t-if="o.currency_id.name == 'USD'" t-esc="'{:,.2f}'.format(line.price_subtotal)"/>
                                                    <span class="text-nowrap" t-elif="o.currency_id.name == 'KHR'" t-esc="'{:,.2f}'.format(round(line.price_subtotal * o.exchange_rate, 2))"/> -->
                                                </td>
                                            </t>
                                            <t t-if="line.display_type == 'line_section'">
                                                <td class="erp-text erp-border" colspan="99">
                                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                </td>
                                                <t t-set="current_section" t-value="line"/>
                                                <t t-set="current_subtotal" t-value="0"/>
                                            </t>
                                            <t t-if="line.display_type == 'line_note'">
                                                <td class="erp-text erp-border" colspan="99">
                                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                </td>
                                            </t>
                                        </tr>

                                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                            <tr class="is-subtotal text-right erp-text erp-border">
                                                <td colspan="99">
                                                    <strong class="mr16">Subtotal</strong>
                                                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-set="amount_total_khr" t-value="0.0"/>
                                    <t t-set="amount_total_khr" t-value="round(o.amount_total*o.exchange_rate,2)"/>

                                    <t t-set="amount_tax_khr" t-value="0.0"/>
                                    <t t-set="amount_tax_khr" t-value="round(amount_total_khr/1.1*0.1,0)"/>

                                    <t t-set="amount_untaxed_khr" t-value="0.0"/>
                                    <t t-set="amount_untaxed_khr" t-value="round(amount_total_khr-amount_tax_khr,0)"/>

                                    <t t-if="o.currency_id.name == 'USD'">
                                        <tr class="erp-text erp-border border-black">
                                            <th t-attf-colspan="{{ '6' if line.discount else '5' }}" class="text-end erp-border">
                                                <span>សរុប - Subtotal</span>
                                            </th>
                                            <th class="erp-text text-end erp-border">
                                                <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </th>
                                        </tr>
                                        <tr class="erp-text erp-border border-black">
                                            <th t-attf-colspan="{{ '6' if line.discount else '5' }}" class="text-end erp-border">
                                                <span>សរុបរួមជាដុល្លារ - Grand Total in USD</span>
                                            </th>
                                            <th class="erp-text text-end erp-border">
                                                <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </th>
                                        </tr>
                                        <tr class="erp-text erp-border border-black">
                                            <th t-attf-colspan="{{ '6' if line.discount else '5' }}" class="text-end erp-border">
                                                <span>សរុបរួមជាប្រាក់រៀល - Grand Total in KHR</span>
                                            </th>
                                            <th class="erp-text text-end erp-border">
                                                <span t-field="o.amount_total_khr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.khr_currency_id}"/>

                                            </th>
                                        </tr>
                                    </t>
                                    <t t-elif="o.currency_id.name == 'KHR'">
                                        <tr class="erp-text erp-border border-black">
                                            <th t-attf-colspan="{{ '6' if line.discount else '5' }}" class="text-end erp-border">
                                                <span>សរុប - Subtotal</span>
                                            </th>
                                            <th class="erp-text text-end erp-border">
                                                <!-- <span t-esc="round(o.amount_untaxed * o.exchange_rate, 2)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.khr_currency_id}"/> -->
                                                <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </th>
                                        </tr>
                                        <tr class="erp-text erp-border border-black">
                                            <th t-attf-colspan="{{ '6' if line.discount else '5' }}" class="text-end erp-border">
                                                <span>សរុបរួមជាប្រាក់រៀល - Grand Total in KHR</span>
                                            </th>
                                            <th class="erp-text text-end erp-border">
                                                <!-- <span t-esc="round(o.amount_total * o.exchange_rate, 2)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.khr_currency_id}"/> -->
                                                <!-- <span t-field="o.amount_total_khr" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.khr_currency_id}"/> -->
                                                <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </th>
                                        </tr>
                                        <tr class="erp-text erp-border border-black">
                                            <th t-attf-colspan="{{ '6' if line.discount else '5' }}" class="text-end erp-border">
                                                <span>សរុបរួមជាដុល្លារ - Grand Total in USD</span>
                                            </th>
                                            <th class="erp-text text-end erp-border">
                                                <span t-field="o.amount_total_usd" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </th>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <!-- Bank Information-->
                            <!-- manual input note -->
                            <div t-if="o.input_narration" class="row" style="margin-top: 30px; margin-bottom: -30px;">
                                <div class="col-9 erp-text">
                                    <p>
                                        <span t-field="o.input_narration"/>
                                    </p>
                                </div>
                                <div class="col-3"/>
                            </div>
                            
                            <!-- dynamic input note -->
                            <div class="row">
                                <div class="row" style="margin-top: 30px;">
                                <div class="col-9 erp-text" t-if="o.bank_information_id and o.bank_information_id.desc">
                                    <p>
                                        <span t-field="o.bank_information_id.desc"/>
                                    </p>
                                </div>
                                <div class="col-3">
                                    <div style="text-align: center;">
                                        <img class="img img-responsive" t-if="o.bank_information_id.qrcode_image" t-att-src="image_data_uri(o.bank_information_id.qrcode_image)" alt="Logo" style="max-height: 175px"/>
                                    </div>
                                </div>
                            </div>
                            </div>
                            <div class="row" style="margin-top: 15px; page-break-inside: avoid;">
                                <div class="col-4">
                                    <div style="color: white;" class="erp-text text-center">-</div>
                                    <div style="border-bottom: 1px solid black; margin-top: 140px; margin-bottom: 5px;"/>
                                    <div class="erp-text text-center">ហត្ថលេខា និងឈ្មោះអ្នកទិញ
                                    </div>
                                    <div class="erp-text text-center">Customer's Signature and Name</div>
                                </div>
                                <div class="col-4">
                                    <div style="color: white;" class="erp-text text-center">-</div>
                                    <div style="border-bottom: ០px solid black; margin-top: 100px; margin-bottom: 5px;"/>
                                </div>
                                <div class="col-4">
                                    <div style="color: white;" class="erp-text text-center">-</div>
                                    <div style="border-bottom: 1px solid black; margin-top: 140px; margin-bottom: 5px;"/>
                                    <div class="erp-text text-center">ហត្ថលេខា និងឈ្មោះអ្នកលក់ </div>
                                    <div class="erp-text text-center">Seller's Signature and Name</div>
                                </div>
                            </div>
                            <br/>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>