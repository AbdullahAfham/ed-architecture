                                                </td>
                                                <td name="account_invoice_line_name" class="text-left erp-text erp-border"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>
                                                <td class="text-right erp-text erp-border">
                                                    <span t-field="line.quantity"/>
                                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                                </td>
                                                <td t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} erp-text erp-border">
                                                    <span class="text-nowrap" t-field="line.price_unit"/>
                                                </td>
                                                <td t-if="display_discount" t-attf-class="text-right {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} erp-text erp-border">
