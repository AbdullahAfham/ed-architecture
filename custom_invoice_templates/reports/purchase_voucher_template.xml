<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Journal Entry -->
        <template id="report_erp_journal_entry">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <style type="text/css">
                                @font-face {
                                    font-family: Moul;
                                    font-style: normal;
                                    src:url('/report_layout_template/static/src/fonts/KhmerOSMuolLight.ttf') format('truetype');
                                }
                                @font-face {
                                    font-family: Battambang;
                                    font-style: normal;
                                    src:url('/report_layout_template/static/src/fonts/Battambang/Battambang-Regular.ttf') format('truetype');
                                }
                                .erp-title {
                                    font-size: 20px;
                                    font-family: Moul;
                                    padding-bottom: 3px;
                                    font-weight: bold;
                                }
                                .erp-title-en{
                                    font-size: 20px;
                                    font-family: 'Time';
                                    padding-bottom: 3px;
                                    font-weight: bold;
                                }
                                .erp-text{
                                    font-size: 14px;
                                    font-family: Battambang;
                                    padding-bottom: 3px;
                                }
                                .erp-border{
                                    border: 1px solid black;
                                }
                                .erp-table-header{
                                    font-weight: bold;
                                    background-color:  #7b7d7d;
                                    color: #FFFFFF;
                                }
                                .erp-table-body{
                                    border: 1px solid black;
                                }
                                .erp-right{
                                    text-align: right;
                                }
                                .erp-center{
                                    text-align: center;
                                }
                            </style>
<!--                            <h4 class="text-center erp-title">-->
<!--                                <span>ទិនានុប្បវត្តិ</span>-->
<!--                            </h4>-->
                            <h4 class="text-center erp-title-en">
                                <span>Purchase Voucher</span>
                            </h4>
                            <div class="row">
                                <div class="col-6">
                                    <div class="row">
                                        <div class="col-4">
                                            <div class="erp-text">Sequence</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.name"/>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-4">
                                            <div class="erp-text">កាលបរិច្ឆេទ/Date</div>
                                        </div>
                                        <div class="col-8">
                                            <div class="erp-text">
                                                : <span t-esc="o.invoice_date" t-options="{'widget': 'date'}"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">

                                </div>
                            </div>

                            <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>

                            <table class="table table-sm o_main_table" name="invoice_line_table">
                                <thead>
                                    <tr class="erp-border">
                                        <th name="th_description" class="text-center erp-text erp-border erp-table-header" style="width: 5%"><span>ល.រ<br/>No</span></th>
                                        <th name="th_description" class="text-center erp-text erp-border erp-table-header" style="width:15%"><span>ឈ្មោះ <br/>Partner</span></th>
                                        <th name="th_description" class="text-center erp-text erp-border erp-table-header" style="width: 35%"><span>បរិយាយ <br/>Description</span></th>
<!--                                        <th name="th_quantity" class="text-center erp-text erp-border erp-table-header" style="width: 10%"><span>គម្រោង<br/>Project</span></th>-->
                                        <th name="th_quantity" class="text-center erp-text erp-border erp-table-header" style="width: 25%"><span>គណនី <br/>Account</span></th>
                                        <th name="th_price_unit" class="text-center erp-text erp-border erp-table-header" style="width: 10%"><span>ឥណពន្ធ<br/>Debit</span></th>
                                        <th name="th_price_unit" class="text-center erp-text erp-border erp-table-header" style="width: 10%"><span>ឥណទាន<br/>Credit</span></th>
                                    </tr>
                                </thead>
                                <tbody class="invoice_tbody">
                                    <t t-set="no" t-value="0"/>
                                    <t t-set="total_credit" t-value="0"/>
                                    <t t-set="total_debit" t-value="0"/>
                                    <t t-foreach="o.line_ids" t-as="line">
                                        <t t-set="no" t-value="no+1"/>

                                        <tr class="border-black">
                                                <td class="text-center erp-text erp-border">
                                                    <span t-esc="no"/>
                                                </td>
                                                <td class="text-start erp-text erp-border">
                                                    <span t-field="line.partner_id.name"/>
                                                </td>

                                                <td class="text-start erp-text erp-border">
                                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                                </td>
<!--                                                <td class="text-center erp-text erp-border">-->
<!--                                                    <span t-field="line.analytic_distribution" t-options="{'widget': 'analytic_distribution'}"/>-->
<!--                                                </td>-->
                                                <td class="text-start erp-text erp-border">
                                                    <span t-field="line.account_id.code" t-options="{'widget': 'text'}"/> <span t-field="line.account_id.name" t-options="{'widget': 'text'}"/>
                                                </td>
                                                <td class="text-center erp-text erp-border">
                                                    <span t-field="line.debit" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                </td>
                                                <td class="text-center erp-text erp-border">
                                                    <span t-field="line.credit" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                                                </td>
                                                <t t-set="total_credit" t-value="total_credit + line.credit"/>
                                                <t t-set="total_debit" t-value="total_debit + line.debit"/>
                                        </tr>

                                    </t>

                                    <tr class="border-black o_subtotal">
                                        <td class="text-center erp-text erp-border" colspan="4">
                                            <strong>Total</strong>
                                        </td>
                                        <td class="text-center erp-text erp-border">
                                            <span class="text-nowrap" t-esc="total_debit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                        <td class="text-center erp-text erp-border">
                                            <span class="text-nowrap" t-esc="total_credit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="row" style="margin-top: 15px; page-break-inside: avoid;">
                                <div class="col-4">
                                    <div class="erp-text text-center">រៀបចំដោយ Prepared By</div>

                                    <div style="border-bottom: 1px solid black; margin-top: 70px;"/>
                                    <div class="erp-text text-left"> ឈ្មោះ/Name:</div>
                                    <div class="erp-text text-left">តួនាទី/Title:</div>
                                    <div class="erp-text text-left">កាលបរិច្ឆេទ/Date:</div>
                                </div>
                                <div class="col-4" style="padding-left: 10px;">
                                    <div class="erp-text text-center">ពិនិត្យដោយ Checked By</div>

                                    <div style="border-bottom: 1px solid black; margin-top: 70px;"/>
                                    <div class="erp-text text-left"> ឈ្មោះ/Name:</div>
                                    <div class="erp-text text-left">តួនាទី/Title:</div>
                                    <div class="erp-text text-left">កាលបរិច្ឆេទ/Date:</div>
                                </div>
                                <div class="col-4" style="padding-left: 10px;">
                                    <div class="erp-text text-center">អនុញ្ញាតដោយ Approved By</div>

                                    <div style="border-bottom: 1px solid black; margin-top: 70px;"/>
                                    <div class="erp-text text-left"> ឈ្មោះ/Name:</div>
                                    <div class="erp-text text-left">តួនាទី/Title:</div>
                                    <div class="erp-text text-left">កាលបរិច្ឆេទ/Date:</div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>