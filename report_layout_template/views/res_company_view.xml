<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- SOPHANON ADDED Company Name in Khmer and Address in Khmer -->
        <record id="view_company_form_inherit_erp" model="ir.ui.view">
            <field name="name">res.company.khmer</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <!-- find field description and add the field
                     idea_ids after it -->
                <xpath expr="//field[@name='partner_id']" position="before">
                  <field name="khmer_name" string="Khmer Name" placeholder="Khmer Name"/>
                </xpath>
                <xpath expr="//field[@name='phone']" position="before">
                  <field name="khmer_address" string="Khmer Address"/>
                </xpath>
            </field>
        </record>

        <record id="view_partner_form_inherit_erp" model="ir.ui.view">
            <field name="name">res.partner.khmer</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- find field description and add the field
                     idea_ids after it -->
                <xpath expr="//field[@name='vat']" position="before">
                  <field name="khmer_name" string="Name in Khmer" placeholder="Khmer Name"/>
                </xpath>
                <xpath expr="//field[@name='khmer_name']" position="after">
                  <field name="khmer_address" string="Khmer Address"/>
                </xpath>
                <xpath expr="//group[@name='sale']" position="inside">
                  <field name="is_customer"/>
                </xpath>
                <xpath expr="//group[@name='purchase']" position="inside">
                  <field name="is_vendor"/>
                </xpath>
            </field>
        </record>
        <record id="account_move_form_inherit_erp" model="ir.ui.view">
            <field name="name">account.move.form.khmer</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- find field description and add the field
                     idea_ids after it -->
                <xpath expr="//field[@name='payment_reference']" position="after">
                  <field name="khr_currency_id" string="Khmer Riel" readonly="state != 'draft'"/>
<!--                  <field name="exchange_date" string="Exchange Date" readonly="state != 'draft'"/>-->
                  <field name="exchange_rate" string="Exchange Rate" readonly="state != 'draft'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>