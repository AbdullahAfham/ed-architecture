        <template id="external_layout_template_center">
            <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                <div class="o_center_header">
                    <style type="text/css">
                        @font-face {
                            font-family: Moul;
                            font-style: normal;
                            src:url('/report_layout_template/static/src/fonts/KhmerOSMuolLight.ttf') format('truetype');
                        }
                        @font-face {
                            font-family: Battambang;
                            font-style: normal;
                            src:url('/report_layout_template/static/src/fonts/Battambang/Battambang-Regular.ttf') format('truetype');
                        }
                        .erp-title{
                            font-size: 26px;
                            font-family: Moul;
                            padding-bottom: 3px;
                            font-weight: bold;
                        }
                        .erp-title-en{
                            font-size: 20px;
                            font-family: 'Time';
                            padding-bottom: 3px;
                            font-weight: bold;
                        }
                        .erp-text{
                            font-size: 14px;
                            font-family: Battambang
                            padding-bottom: 3px;
                        }
                        .erp-border{
                            border: 1px solid black;
                        }
                        .erp-table-header{
                            font-weight: bold;
                            border: 1px solid black;
                        }
                        .erp-table-body{
                            border: 1px solid black;
                        }
                    </style>


                    <div class="row mb2">
                        <div class="col-2 mb2">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height: 110px; margin-top:10px;"/>
                        </div>
                        <div class="col-8 mb6" style="margin-top:10px;">
                            <h3 class="mt0 erp-title text-center" t-field="company.khmer_name"/>
                            <h4 class="mt0 erp-title-en text-center" t-field="company.partner_id.name"/>

                        </div>
                        <div class="col-2 mb2">
                            <span/>
                        </div>
                    </div>
                    <div class="row">
                      <div class="col-1"/>
                      <div class="col-10">
                        <div name="company_address" class="float-center mb6">
                            <ul class="list-unstyled erp-text text-center">
                                <li style="font-family: 'Battambang'; font-size:12px;" t-if="company.vat">លេខអត្តសញ្ញាណកម្ម អតប (VATTIN): <strong><span t-field="company.vat"/></strong></li>
                                <li style="font-family: 'Battambang'; font-size:12px;" t-if="company.khmer_address">អាស័យដ្ឋាន: <span t-field="company.khmer_address"/></li>
                                <li style="font-family: 'Battambang'; font-size:12px;">Address:
                                    <span t-if="company.street" t-esc="company.street"/>,
                                    <span t-if="company.city" t-esc="company.city"/>
                                    <span t-if="company.country_id" t-esc="company.country_id.name"/>
                                    </li>
                                <li style="font-size:12px;">TEL: <span class="" t-field="company.phone"/></li>
                            </ul>
                        </div>
                        <div class="col-1"/>
                      </div>
                    </div>
                    <div style="border-bottom: 1px solid black;"/>
                </div>
            </div>
            <div t-attf-class="article o_report_layout_center o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <div class="pt-5">
                     <!--This div ensures that the address is not cropped by the header. -->
                    <t t-call="web.address_layout"/>
                    <!--I am here!-->
                </div>
                <t t-raw="0"/>
            </div>
            <div t-attf-class="footer o_center_footer o_company_#{company.id}_layout">
                <div class="text-center">
<!--                    <ul class="list-inline">-->
<!--                        <li t-if="company.phone" class="list-inline-item"><span class="o_force_ltr" t-field="company.phone"/></li>-->
<!--                        <li t-if="company.email" class="list-inline-item"><span t-field="company.email"/></li>-->
<!--                        <li t-if="company.website" class="list-inline-item"><span t-field="company.website"/></li>-->
<!--&lt;!&ndash;                        <li t-if="company.vat" class="list-inline-item"><t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-field="company.vat"/></li>&ndash;&gt;-->
<!--                    </ul>-->
                    <!--<div t-field="company.report_footer"/>-->
                    <div t-if="report_type == 'pdf'">
                        Page: <span class="page"/> of <span class="topage"/>
                    </div>
                </div>
            </div>
        </template>

