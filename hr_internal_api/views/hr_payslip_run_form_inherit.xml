<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <record id="hr_payslip_run_form_inherit" model="ir.ui.view">
            <field name="name">hr.payslip.run.form.inherit</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
            <field name="arch" type="xml">
                <!-- Add Notify Release Payslip Button after Validate Payslip Button in Done State -->
                <xpath expr="//button[@name='action_paid']" position="after">
                    <button name="action_notify_release_payslip" string="Release Payslip" type="object" class="oe_highlight" states="close"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
