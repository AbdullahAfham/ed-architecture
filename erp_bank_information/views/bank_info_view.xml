<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="bank_information_form_view" model="ir.ui.view">
            <field name="name">bank.information.form</field>
            <field name="model">bank.information</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" placeholder="Name"/>
                            <!-- <field name="desc" widget="html" /> -->
                            <field name="desc"/>
                            <field name="qrcode_image" widget="image" options="{'size': [360, 360]}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="bank_information_list_view" model="ir.ui.view">
            <field name="name">bank.information.list</field>
            <field name="model">bank.information</field>
            <field name="arch" type="xml">
                <list string="Notes">
                    <field name="name"/>
                    <field name="desc"/>
                </list>
            </field>
        </record>

        <record id="bank_information_act_window" model="ir.actions.act_window">
            <field name="name">Notes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">bank.information</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click here to add new Notes.
                </p>
            </field>
        </record>

        <menuitem name="Notes" id="bank_information_menu"
                  action="bank_information_act_window"
                  groups="base.group_no_one" 
                  parent="account.menu_finance_configuration"  
                  sequence="99"/>

    </data>
</odoo>