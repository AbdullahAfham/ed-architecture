<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
      <record id="view_account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
          <xpath expr="//group[@id='header_left_group']/field[@name='partner_shipping_id']" position="after">
            <field name="invoice_sale_represent_id" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
          </xpath>
          <xpath expr="//field[@name='invoice_date']" position="after">
            <field name="bank_information_id" invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
          </xpath>
          <!-- replace narroration -->
          <xpath expr="//group/group/field[@name='narration']" position="replace">
              <field colspan="2" name="input_narration" nolabel="1" placeholder="Terms and conditions..."/>
          </xpath>
        </field>
      </record>
    </data>
</odoo>