<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="update_attendance_wizard_form_view" model="ir.ui.view">
        <field name="name">update.attendance.wizard.form</field>
        <field name="model">update.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Attendance">
                <field name="state" invisible="1"/>
                <group col="2">
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        <field name="employee_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_update_attendance" string="Update Attendance" type="object" class="oe_highlight" />
                    or
                    <button
                        special="cancel"
                        string="Cancel"
                        icon="fa-close"
                        class="btn btn-primary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!--Action for payroll information wizard -->
    <record id="action_update_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Update Attendance</field>
        <field name="res_model">update.attendance.wizard</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="wizard_update_attendance_menu"
        name="Update Attendance"
        action="action_update_attendance_wizard"
        parent="erp_qr_attendance.menu_scan_configuration"
        sequence="29"
        groups="hr.group_hr_manager"
    />

</odoo>