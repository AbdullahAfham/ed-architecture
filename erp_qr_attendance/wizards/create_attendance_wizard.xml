<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pre_create_attendance_wizard_form_view" model="ir.ui.view">
        <field name="name">pre.create.attendance.wizard.form</field>
        <field name="model">pre.create.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Pre Create Attendance">
                <field name="state" invisible="1"/>
                <group col="2">
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        <field name="employee_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_attendance" string="Create Attendance" type="object" class="oe_highlight" />
                    or
                    <button
                        special="cancel"
                        string="Cancel"
                        icon="fa-close"
                        class="btn btn-primary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!--Action for payroll information wizard -->
    <record id="action_pre_create_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Pre Create Attendance</field>
        <field name="res_model">pre.create.attendance.wizard</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="wizard_pre_create_attendance_menu"
        name="Pre Create Attendance"
        action="action_pre_create_attendance_wizard"
        parent="hr_attendance.menu_hr_attendance_configuration"
        sequence="100"
        groups="hr.group_hr_manager"
    />

</odoo>