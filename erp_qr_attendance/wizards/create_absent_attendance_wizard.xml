<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="create_absent_attendance_wizard_form_view" model="ir.ui.view">
        <field name="name">create.absent.attendance.wizard.form</field>
        <field name="model">create.absent.attendance.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Absent Attendance">
                <field name="state" invisible="1"/>
                <group col="2">
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        <field name="employee_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_absent_attendance" string="Create Absent Attendance" type="object" class="oe_highlight" />
                    or
                    <button
                        special="cancel"
                        string="Cancel"
                        icon="fa-close"
                        class="btn btn-primary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_absent_attendance_wizard" model="ir.actions.act_window">
        <field name="name">Create Absent Attendance</field>
        <field name="res_model">create.absent.attendance.wizard</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="wizard_create_absent_attendance_menu"
        name="Create Absent Attendance"
        action="action_create_absent_attendance_wizard"
        parent="hr_attendance.menu_hr_attendance_configuration"
        sequence="102"
        groups="hr.group_hr_manager"
    />

</odoo>