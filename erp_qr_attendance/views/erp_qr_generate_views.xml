<odoo>
  <data>

    <!-- Form View -->
    <record id="erp_qr_generate_form_view" model="ir.ui.view">
        <field name="name">erp.qr.generate.form.view</field>
        <field name="model">erp.qr.generate</field>
        <field name="arch" type="xml">
            <form string="QR Generate">
                <header>
                    <button name="action_generate_qrcode" string="Generate QR" type="object" class="btn-primary"/>
                    <!-- <button name="action_generate_qrcode" string="Regenerate QR" type="object" class="btn-primary" confirm="Are you sure you want to proceed?"/> -->
                </header>
                <sheet>
                    <field name="id" invisible="True"/>
                    <field name="qr_code_img" widget="image" class="oe_avatar" options="{'preview_image': 'qr_code_img'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Reference ...."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="latitude" string="Geo Location"/>
                            <div class="d-flex">
                                <field name="latitude" nolabel="1" class="oe_inline"/>,<field name="longitude" nolabel="1" class="oe_inline" />
                            </div>
                            <div>
                                <span>Lat : </span>
                                <field name="latitude" nolabel="1" class="oe_inline"/>
                                <span>, Long: </span>
                                <field name="longitude" nolabel="1" class="oe_inline"/>
                                <br/>
                                <span invisible="not date_localization">Updated on: </span>
                                <field name="date_localization" nolabel="1" class="oe_inline"/>
                            </div>
                            <field name="resource_calendar_id"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="location_id"/>
                            <field name="radius"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="erp_qr_attendance.erp_qr_generate_list_view">
      <field name="name">erp.qr.generate.list.view</field>
      <field name="model">erp.qr.generate</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="project_id"/>
          <field name="latitude"/>
          <field name="longitude"/>
        </list>
      </field>
    </record>

    <record id="erp_qr_attendance.erp_qr_generate_kanban_view" model="ir.ui.view">
        <field name="name">QR GENERATE</field>
        <field name="model">erp.qr.generate</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('erp.qr.generate', 'qr_code_img', record.id.raw_value)" alt="QR" class="o_image_64_contain"/>
                            </div>
                            <div class="oe_kanban_details">
                                <field name="priority" widget="priority" readonly="1"/>
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <ul>
                                    <li><strong>Lat/Log: <field name="latitude"/>-<field name="longitude"/></strong></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_erp_qr_generate" model="ir.actions.act_window">
        <field name="name">QR Generate</field>
        <field name="res_model">erp.qr.generate</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create new QR code for your project!
            </p>
        </field>
    </record>

    <!-- Top menu item -->
    <menuitem name="QRCODE SCAN" 
        id="erp_qr_attendance.menu_erp_qr_generate_root"
        web_icon="erp_qr_attendance,static/description/icon.png"
        />

    <!-- menu categories -->
    <menuitem name="Configuration" 
        id="erp_qr_attendance.menu_scan_configuration" 
        parent="erp_qr_attendance.menu_erp_qr_generate_root" 
        sequence="100"/>

    <!-- actions -->
    <menuitem name="QRCODE LIST" 
        id="erp_qr_attendance.menu_qr_code_list" 
        parent="erp_qr_attendance.menu_scan_configuration"
        action="erp_qr_attendance.action_erp_qr_generate"/>

  </data>
</odoo>