<odoo>
  <data>

    <!-- Form View -->
    <record id="scan_qr_overtime_form_view" model="ir.ui.view">
        <field name="name">scan.qr.overtime.form.view</field>
        <field name="model">scan.qr.overtime</field>
        <field name="arch" type="xml">
            <form string="QR Overtime">
                <sheet>
                    <field name="id" invisible="True"/>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" placeholder="Employee"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="project_id"/>
                            <field name="location_id"/>
                            <field name="qr_id"/>
                        </group>
                        <group>
                            <field name="scan_time"/>
                            <field name="scan_type"/>
                            <field name="late_state" optional="hide"/>
                            <field name="late" optional="hide"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="erp_qr_attendance.scan_qr_overtime_list_view">
        <field name="name">scan.qr.overtime.list.view</field>
        <field name="model">scan.qr.overtime</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="date" optional="show"/>
                <field name="scan_time" optional="show"/>
                <field name="scan_type" optional="show"/>
                <field name="location_id" optional="show"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="late_state" optional="hide"/>
                <field name="late" optional="hide"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_scan_qr_overtime" model="ir.actions.act_window">
        <field name="name">Scan QR Overtime</field>
        <field name="res_model">scan.qr.overtime</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                All data are coming from mobile self service
            </p>
        </field>
    </record>

    <!-- menu categories -->
    <menuitem name="OVERTIME LOGS" 
        id="erp_qr_attendance.menu_scan_overtime_log" 
        parent="erp_qr_attendance.menu_erp_qr_generate_root"/>
    
    <!-- actions -->
    <menuitem name="Overtime Logs" 
        id="erp_qr_attendance.menu_scan_qr_overtime" 
        parent="erp_qr_attendance.menu_scan_overtime_log"
        action="erp_qr_attendance.action_scan_qr_overtime"/>

  </data>
</odoo>