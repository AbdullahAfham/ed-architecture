<odoo>
  <data>
    <record model="ir.ui.view" id="view_scan_qr_attendance_pivot">
        <field name="name">scan.qr.attendance.pivot</field>
        <field name="model">scan.qr.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Scan Attendance" sample="1">
                <field name="date" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="late" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Sales Orders Kanban View  -->
    <record model="ir.ui.view" id="view_scan_qr_attendance_kanban">
        <field name="name">scan.qr.attendance.kanban</field>
        <field name="model">scan.qr.attendance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" quick_create="false">
                <field name="employee_id"/>
                <field name="late"/>
                <field name="date"/>
                <field name="late_state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings mt4">
                                    <strong class="o_kanban_record_title"><span><t t-esc="record.employee_id.value"/></span></strong>
                                </div>
                                <strong><field name="late" widget="monetary"/></strong>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <span><t t-esc="record.date.value"/></span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="late_state" widget="label_selection" options="{'classes': {'late': 'default', 'missed': 'default', 'good': 'success'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="scan_qr_attendance_form_view" model="ir.ui.view">
        <field name="name">scan.qr.attendance.form.view</field>
        <field name="model">scan.qr.attendance</field>
        <field name="arch" type="xml">
            <form string="Scan Attendance">
                <sheet>
                    <field name="id" invisible="True"/>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" placeholder="Employee" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1" invisible="1"/>
                            <field name="resource_calendar_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="location_id" readonly="1"/>
                            <field name="qr_id" readonly="1"/>
                            <field name="latitude" readonly="1"/>
                            <field name="longitude" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="day_period" readonly="1"/>
                            <field name="scan_time" readonly="1"/>
                            <field name="scan_type" readonly="1"/>
                            <field name="late_state" readonly="1"/>
                            <field name="late" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="erp_qr_attendance.scan_qr_attendance_list_view">
        <field name="name">scan.qr.attendance.list.view</field>
        <field name="model">scan.qr.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id" optional="show"/>
                <field name="day_period" optional="show"/>
                <field name="date" optional="show"/>
                <field name="scan_time" optional="show" string="Time"  widget="time"/>
                <field name="scan_type" optional="show"/>
                <field name="location_id" optional="hide"/>
                <field name="project_id" optional="hide"/>
                <field name="latitude" optional="show"/>
                <field name="longitude" optional="show"/>
                <field name="late_state" optional="show"/>
                <field name="late" optional="show" widget="float_time"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="scan_qr_attendance_serach_view" model="ir.ui.view">
        <field name="name">scan.qr.attendance.view.filter</field>
        <field name="model">scan.qr.attendance</field>
        <field name="arch" type="xml">
            <search string="Scan Attendances">
                <filter string="Today" name="filter_today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group string="Group By">
                    <filter name="groupby_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_scan_qr_attendance" model="ir.actions.act_window">
        <field name="name">Scan Attendance</field>
        <field name="res_model">scan.qr.attendance</field>
        <field name="view_mode">list,form,kanban,pivot</field>
        <field name="help" type="html">
        <!-- <field name="context">{'search_default_filter_today': 1}</field> -->
            <p class="oe_view_nocontent_create">
                All data are coming from mobile self service
            </p>
        </field>
    </record>

    <!-- menu categories -->
    <menuitem name="ATTENDANCE LOGS" 
        id="erp_qr_attendance.menu_scan_qr" 
        parent="erp_qr_attendance.menu_erp_qr_generate_root"/>

    <!-- actions -->
    <menuitem name="Attendance Logs" 
        id="erp_qr_attendance.menu_scan_qr_attendance" 
        parent="erp_qr_attendance.menu_scan_qr"
        action="erp_qr_attendance.action_scan_qr_attendance"/>

  </data>
</odoo>