<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_payslip_run_inherit_form_view" model="ir.ui.view">
        <field name="name">hr.payslip.run.inherit.form</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="before">
                <field name="khr_currency_id"/>
                <field name="exchange_date" readonly="state != 'draft'"/>
                <field name="exchange_rate" readonly="state != 'draft'"/>
                <field name="payroll_type" readonly="state != 'draft'"/>
            </field>
        </field>
    </record>
</odoo>
