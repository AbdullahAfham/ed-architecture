<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_employee_inherit_spouse_form_view" model="ir.ui.view">
        <field name="name">hr.employee.spouse.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="children" position="after">
                <field name="spouse_number"/>
            </field>
        </field>
    </record>

    <record id="hr_contract_inherit_form_view" model="ir.ui.view">
        <field name="name">hr.contract.inherit.form</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary_info']" position="inside">
              <group name="allowance">
                <label for="allowance"/>
                <div class="o_row" name="allowance">
                    <field name="allowance" nolabel="1" readonly="False"/>
                    <span>/ month</span>
                </div>
              </group>
            </xpath>
        </field>
    </record>
</odoo>
