<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--Form view for Print iBanking -->
    <record id="print_payroll_report_wizard_form_view" model="ir.ui.view">
        <field name="name">print.payroll.report.wizard.form</field>
        <field name="model">print.payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Payroll Report">
                <field name="state" invisible="1"/>
                <field name="name" invisible="1"/>
                <group col="4" invisible="state != 'choose'">
                    <field name="date_from" />
                    <field name="date_to" />
                </group>
                <group col="4" invisible="state != 'choose'">
                    <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                </group>
                <div invisible="state != 'get'">
                        <h2>Download Payroll Report XLS</h2>
                        <p>File : <field name="data" readonly="1" filename="name"/></p>
                </div>
                <footer invisible="state != 'choose'">
                    <button name="print_xls_payroll_report" string="PAYROLL REPORT" type="object" class="oe_highlight" />
                    or
                    <button
                        special="cancel"
                        string="Cancel"
                        icon="fa-close"
                        class="btn btn-primary"
                    />
                </footer>
                <footer invisible="state != 'get'">
                    <button name="go_back" string="Go Back" type="object" class="oe_highlight" />
                    or
                    <button special="cancel" string="Close" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <!--Action for payroll information wizard -->
    <record id="action_print_payroll_report_wizard" model="ir.actions.act_window">
        <field name="name">Payroll Report</field>
        <field name="res_model">print.payroll.report.wizard</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        id="wizard_print_payroll_report_menu"
        name="PAYROLL REPORT"
        action="action_print_payroll_report_wizard"
        parent="hr_payroll.menu_hr_payroll_report"
        sequence="29"
        groups="hr_payroll.group_hr_payroll_manager"
    />

</odoo>