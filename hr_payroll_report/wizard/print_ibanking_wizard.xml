<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--Form view for Print iBanking -->
    <record id="print_payroll_ibanking_wizard_form_view" model="ir.ui.view">
        <field name="name">print.ibanking.wizard.form</field>
        <field name="model">print.ibanking.wizard</field>
        <field name="arch" type="xml">
            <form string="iBanking">
                <field name="state" invisible="1"/>
                <field name="name" invisible="1"/>
                <group col="4" invisible="state != 'choose'">
                    <field name="date_from" />
                    <field name="date_to" />
                </group>
                <group col="4" invisible="state != 'choose'">
                    <field name="bank" />
                    <field name="struct_id" />
                </group>
                <div invisible="state != 'get'">
                    <h2>Download iBanking XLS</h2>
                    <p>File : <field name="data" readonly="1" filename="name"/>
                    </p>
                </div>
                <footer invisible="state != 'choose'">
                    <button name="print_xls_ibanking_report" string="iBANKING" type="object" class="oe_highlight" />
                    or
                    <button special="cancel" string="Cancel" icon="fa-close" class="btn btn-primary" />
                </footer>
            </form>
        </field>
    </record>

    <!--Action for payroll information wizard -->
    <record id="action_print_ibanking_wizard" model="ir.actions.act_window">
        <field name="name">HR payroll Print iBanking Report</field>
        <field name="res_model">print.ibanking.wizard</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

