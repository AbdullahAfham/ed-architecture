<odoo>

    <!-- LIST VIEW -->
    <record id="view_call_plans_stages_list" model="ir.ui.view">
        <field name="name">call.plans.stages.list</field>
        <field name="model">call.plans.stages</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="display_stage"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_call_plans_stages_form" model="ir.ui.view">
        <field name="name">call.plans.stages.form</field>
        <field name="model">call.plans.stages</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_first_stage"/>
                        <field name="is_last_stage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_call_plans_stages" model="ir.actions.act_window">
        <field name="name">Call Plans Stages</field>
        <field name="res_model">call.plans.stages</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_call_plans_tags_list" model="ir.ui.view">
        <field name="name">call.plans.tags.list</field>
        <field name="model">call.plans.tags</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_call_plans_tags_form" model="ir.ui.view">
        <field name="name">call.plans.tags.form</field>
        <field name="model">call.plans.tags</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_call_plans_types_list" model="ir.ui.view">
        <field name="name">call.plans.types.list</field>
        <field name="model">call.plans.types</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_call_plans_types_form" model="ir.ui.view">
        <field name="name">call.plans.types.form</field>
        <field name="model">call.plans.types</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_call_plans_tags" model="ir.actions.act_window">
        <field name="name">Call Plans tags</field>
        <field name="res_model">call.plans.tags</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_call_plans_types" model="ir.actions.act_window">
        <field name="name">Call Plans Types</field>
        <field name="res_model">call.plans.types</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>