<odoo>

    <!-- KANBAN VIEW -->
    <record id="view_call_plans_kanban" model="ir.ui.view" >
        <field name="name">call.plans.kanban</field>
        <field name="model">call.plans</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" default_group_by="stage_id" sample="1">
                <templates>
                    <progressbar field="kanban_state" colors='{"normal": "200", "done": "success", "blocked": "danger"}'/>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card" class="flex-row">
                        <aside>
                            <field name="image" widget="image" options="{'zoom': true, 'background': true, 'preventClicks': false}"/>
                        </aside>
                        <main>
                            <div name="studio_auto_kanban_header" class="d-flex">
                                <field name="priority" widget="boolean_favorite" nolabel="1"/>
                                <field name="name" class="h5"/>
                            </div>
                            <div name="studio_auto_kanban_body">
                                <field name="tag_ids"/>
                            </div>
                            <footer>
                                <div class="ms-auto d-flex align-items-center">
                                    <field name="kanban_state" widget="state_selection"/>
                                    <field class="ms-1" name="user_id" widget="kanban.many2one_avatar_user"/>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_call_plans_list" model="ir.ui.view">
        <field name="name">call.plans.list</field>
        <field name="model">call.plans</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="Description"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="tag_ids"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_call_plans_form" model="ir.ui.view">
        <field name="name">call.plans.form</field>
        <field name="model">call.plans</field>
        <field name="arch" type="xml">
            <form string="Call Plans">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet string="Call Plans">
                    <field name="active" invisible="1"/>
                    <div class="d-flex gap-4 mb-3">
                        <div class="flex-grow-1">
                            <label for="name"/>
                            <h1>
                                <field name="name" required="1" placeholder="e.g. Following up with a new customer" class="w-sm-75"/>
                            </h1>
                        </div>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <field name="kanban_state" widget="state_selection"/>
                    </div>
                    <group name="main_group">
                        <group name="left_group">
                            <field name="partner_id"/>
                            <field name="partner_phone" widget="phone" options="{'enable_sms': True}"/>
                            <field name="partner_email" widget="email"/>
                            <field name="date"/>
                            <field name="date_start" string="Dates" widget="daterange" options="{'end_date_field': 'date_stop'}"/>
                            <field name="date_stop" invisible="1"/>
                        </group>
                        <group name="right_group">
                            <field name="plan_type_id" required="True"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Type down your notes here..." nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- CALENDER VIEW -->
    <record id="view_call_plans_calendar" model="ir.ui.view" >
        <field name="name">call.plans.calendar</field>
        <field name="model">call.plans</field>
        <field name="arch" type="xml">
            <calendar date_start="date" create_name_field="name"/>
        </field>
    </record>

    <!-- GANTT VIEW -->
    <record id="view_call_plans_gantt" model="ir.ui.view" >
        <field name="name">call.plans.gantt</field>
        <field name="model">call.plans</field>
        <field name="arch" type="xml">
            <gantt date_start="date_start" date_stop="date_stop"/>
        </field>
    </record>

    <!-- MAP VIEW -->
    <record id="view_call_plans_map" model="ir.ui.view" >
        <field name="name">call.plans.map</field>
        <field name="model">call.plans</field>
        <field name="arch" type="xml">
            <map res_partner="partner_id">
                <field name="partner_id" string="Partner"/>
            </map>
        </field>
    </record>

    <record id="action_call_plans" model="ir.actions.act_window">
        <field name="name">Call Plans</field>
        <field name="res_model">call.plans</field>
        <field name="view_mode">kanban,list,form,calendar,gantt,map</field>
    </record>
</odoo>
