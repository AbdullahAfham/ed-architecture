<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="hr_payslip_tree_iniherit" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='basic_wage']" position="attributes">
                <attribute name="sum">Total Basic Wage</attribute>
            </xpath>
            <xpath expr="//field[@name='net_wage']" position="attributes">
                <attribute name="sum">Total Net</attribute>
            </xpath>
            <xpath expr="//field[@name='gross_wage']" position="attributes">
                <attribute name="sum">Total Gross</attribute>
            </xpath>

            <xpath expr="//field[@name='basic_wage']" position="after">
                <field name="addition" sum="Addition" optional="show" readonly="1"/>
                <field name="deduction" sum="Deduction" optional="show" readonly="1"/>
                <field name="unpaid" sum="Unpaid" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>