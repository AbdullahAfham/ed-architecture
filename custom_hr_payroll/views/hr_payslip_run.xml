<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <data>
        <record id="hr_payslip_run_iniherit" model="ir.ui.view">
            <field name="name">hr.payslip.run.inherit</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//div[hasclass('o_row')]" position="after">
                        <field name="total_basic_wage" invisible="total_basic_wage == 0.0"/>
                        <field name="total_addition" invisible="total_addition == 0.0"/>
                        <field name="total_deduction" invisible="total_deduction == 0.0"/>
                        <field name="total_unpaid" invisible="total_unpaid == 0.0"/>
                        <field name="total_net_wage" invisible="total_net_wage == 0.0"/>

                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>