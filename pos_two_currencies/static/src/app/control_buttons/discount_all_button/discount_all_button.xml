<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_two_currencies.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <t t-if="pos.config.iface_disc_button">
                <!-- All buttons always displayed -->
                <button t-att-class="buttonClass"
                        t-att-disabled="!pos.get_order()?.get_orderlines()?.length"
                        t-on-click="clickDiscountAll">
                    <i class="fa fa-percent me-1" />
                    <span>Discount All</span>
                </button>
            </t>
        </xpath>
    </t>

</templates>
