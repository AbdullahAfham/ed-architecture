<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_two_currencies.OpeningControlPopup" t-inherit="point_of_sale.OpeningControlPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('cash-input-sub-section')]" position="replace">
            <div class="cash-input-sub-section input-group">
                <span class="input-group-text bg-secondary">Cash USD</span>
                <Input tModel="[state, 'openingCash']"
                    isValid.bind="env.utils.isValidFloat"
                    callback.bind="handleInputChange"
                    autofocus="true" />
                <div class="button icon btn btn-secondary" t-on-click="openDetailsPopup">
                    <i class="fa fa-money fa-2x" role="img" title="Open the money details popup"/>
                </div>
            </div>
            <div class="cash-input-sub-section input-group">
                <span class="input-group-text bg-secondary">Cash KHR</span>
                <Input tModel="[state, 'openingCashKHR']"
                    isValid.bind="env.utils.isValidFloat"
                    callback.bind="handleInputChangeKHR"
                    autofocus="true" />
                <div class="button icon btn btn-secondary" t-on-click="openDetailsKHRPopup">
                    <i class="fa fa-money fa-2x" role="img" title="Open the money details popup"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
