<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_two_currencies.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath  expr="//div[hasclass('payment-methods-overview')]"  position="before">
            <div class="mb-2 pb-2 text-start">
                <div class="section-financials-body d-flex flex-column flex-sm-row">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th class="p-0" t-esc="session_name"/>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
        <xpath expr="//tbody[last()]" position="after">
            <t t-if="pos.config.cash_control &amp;&amp; props.default_cash_details_khr">
                <tbody>
                    <tr>
                        <td t-esc="props.default_cash_details_khr.name"/>
                        <td t-esc="formatKHR(props.default_cash_details_khr.amount)"/>
                        <td class="d-flex">
                            <Input tModel="[state.payments[props.default_cash_details_khr.id], 'counted']"
                                callback.bind="(value) =>  this.setManualCashKHRInput(value)"
                                isValid.bind="env.utils.isValidFloat"/>
                            <div class="button icon ClosePosPopup btn btn-secondary" t-on-click="openDetailsKHRPopup">
                                <i class="fa fa-money fa-2x" role="img" title="Open the money details popup"/>
                            </div>
                        </td>
                        <td t-esc="formatKHR(getDifference(props.default_cash_details_khr.id))"
                            t-att-class="{'warning text-danger fw-bolder': !env.utils.floatIsZero(getDifference(props.default_cash_details_khr.id))}"/>
                    </tr>
                </tbody>
                <tbody class="cash-overview border-start small text-muted">
                    <tr>
                        <td>Opening</td>
                        <td class="align-top" t-esc="formatKHR(props.default_cash_details_khr.opening)"/>
                    </tr>
                    <tr t-foreach="props.default_cash_details_khr.moves" t-as="move" t-key="move_index">
                        <td>
                            <div class="flex d-flex flex-row">
                                <div class="cash-sign me-1" t-esc="move.amount &lt; 0 ? '-' : '+'"/>
                                <t t-esc="move.name"/>
                            </div>
                        </td>
                        <td class="align-top" t-esc="formatKHR(Math.abs(move.amount))"/>
                    </tr>
                    <tr t-if="props.default_cash_details_khr.payment_amount">
                        <td>
                            <div class="flex d-flex flex-row">
                                <div class="cash-sign me-1" t-esc="props.default_cash_details_khr.payment_amount &lt; 0 ? '-' : '+'"/>
                                Payments in <t t-esc="props.default_cash_details_khr.name"/>
                            </div>
                        </td>
                        <td class="align-top" t-esc="formatKHR(Math.abs(props.default_cash_details_khr.payment_amount))"/>
                    </tr>
                </tbody>
            </t>
        </xpath>
    </t>
</templates>
