<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_two_currencies.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-methods-overview')]" position="before">
            <div class="mb-2 pb-2 text-start">
                <div class="section-financials-body d-flex flex-column flex-sm-row">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th class="p-0" t-esc="session_name"/>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('payment-methods-overview')]" position="inside">
            <div t-if="pos.config.cash_control &amp;&amp; props.default_cash_details_khr" class="w-100 mb-3">
                <t t-set="diff" t-value="getDifference(props.default_cash_details_khr.id)" />
                <t t-set="counted" t-value="state.payments[props.default_cash_details_khr.id]?.counted || '0'" />
                <div class="d-flex align-items-center justify-content-between fs-3">
                    <span t-esc="props.default_cash_details_khr.name" />
                    <span t-esc="formatKHR(props.default_cash_details_khr.amount)" />
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                    <span>Opening</span>
                    <span t-esc="formatKHR(props.default_cash_details_khr.opening)" />
                </div>
                <div t-if="props.default_cash_details_khr.payment_amount" class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                    <span>Payments in <t t-esc="props.default_cash_details_khr.name"/></span>
                    <span class="align-top" t-esc="formatKHR(props.default_cash_details_khr.payment_amount)"/>
                </div>
                <t t-set="moveData" t-value="cashKHRMoveData"/>
                <PaymentMethodBreakdown title.translate="Cash KHR In / Out" total_amount="cashKHRMoveData.total" transactions="cashKHRMoveData.moves"/>
                <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2">
                    <span>Counted</span>
                    <span t-esc="formatKHR(env.utils.parseValidFloat(counted))" />
                </div>
                <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2" t-att-class="{'text-danger fw-bold': diff}">
                    <span>Difference</span>
                    <span class="cash-difference" t-esc="formatKHR(diff)" />
                </div>
            </div>
        </xpath>
    </t>
</templates>
