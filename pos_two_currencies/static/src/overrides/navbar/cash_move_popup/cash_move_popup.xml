<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_two_currencies.CashMovePopup" t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('input-amount')]" position="inside">
            <Input tModel="[state, 'amountKHR']"
                icon="{type: 'string', value: pos.currency_khr.symbol}"
                iconOnLeftSide="pos.currency_khr.position === 'before'"
                isValid.bind="env.utils.isValidFloat"
                autofocus="true"
                getRef="(ref) => this.inputRef = ref" />
        </xpath>
    </t>
</templates>
