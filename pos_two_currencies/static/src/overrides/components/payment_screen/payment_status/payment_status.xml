<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_two_currencies.PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('total')]" position="after">
            <div class="total text-center py-2 text-success">
                Or
            </div>
            <div class="total text-center py-2 text-success">
                <t t-esc="is_usd ? totalDueTextkhr : totalDueTextUSD" />
            </div>
        </xpath>
<!--        <xpath expr="//div[hasclass('payment-status-remaining')]" position="after">-->
<!--        </xpath>-->
        <xpath expr="//div[hasclass('payment-status-total-due')]" position="after">
            <t t-if="is_usd">
                <div class="payment-status-remaining">
                    <span class="label pe-2">Remaining (KHR)</span>
                    <span class="amount" t-att-class="{ 'highlight text-primary fw-bolder': props.order.get_due() > 0 }">
                        <t t-esc="remainingTextKHR" />
                    </span>
                </div>
                <div class="payment-status-total-due py-2 fs-3 text-muted">
                    <span class="label pe-2">Total Due (KHR) </span>
                    <span>
                        <t t-esc="totalDueTextkhr" />
                    </span>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('payment-status-change')]" position="after">
            <t t-if="is_usd">
                <div class="payment-status-total-due py-2 fs-3 text-muted">
                    <span class="label pe-2">Change (KHR) </span>
                    <span>
                        <t t-esc="changeTextkhr" />
                    </span>
                </div>
            </t>
        </xpath>
    </t>
</templates>
