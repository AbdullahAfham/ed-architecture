<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_two_currencies.PaymentScreenDue"  t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('total')]" position="replace" />
        <section class="paymentlines-container rounded-3 bg-view"
            t-att-class="{'paymentlines-empty': paymentLines.length === 0 }">
            <div class="total text-center py-2 py-lg-4 text-success">
                <div t-esc="this.env.utils.formatCurrency(currentOrder.getTotalDue())" />
                <div >Or</div>
                <div t-esc="totalDueTextkhr" />
            </div>
        </section>
    </t>

    <t t-name="pos_two_currencies.PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-container')]" position="replace">
            <div class="payment-status-container d-flex flex-column-reverse justify-content-between fs-2">
                <div t-if="this.props.order.get_due() gte 0 and props.order.get_change() === 0" class="payment-status-remaining d-flex justify-content-between row">
                    <div t-if="isOnlyUSD || isBothCurrency" class="d-flex justify-content-between flex-grow-1">
                        <span class="label pe-2">Remaining (USD)</span>
                        <span class="amount align-self-end pe-5" t-att-class="{ 'highlight text-danger fw-bolder': props.order.get_due() > 0 }">
                            <t t-esc="remainingText" />
                        </span>
                    </div>
                    <div t-if="isOnlyKHR || isBothCurrency" class="d-flex justify-content-between flex-grow-1">
                        <span class="label pe-2">Remaining (KHR)</span>
                        <span class="amount align-self-end pe-5" t-att-class="{ 'highlight text-danger fw-bolder': props.order.get_due() > 0 }">
                            <t t-esc="remainingTextKHR" />
                        </span>
                    </div>
                </div>
                <div t-else="" class="payment-status-change d-flex justify-content-between row">
                    <div t-if="isOnlyUSD || isBothCurrency" class="d-flex justify-content-between flex-grow-1">
                        <span class="label pe-2">Change (USD)</span>
                        <span class="amount align-self-end pe-5" t-att-class="{ 'highlight text-success fw-bolder': props.order.get_change() > 0 }">
                            <t t-esc="changeText" />
                        </span>
                    </div>
                    <div t-if="isOnlyKHR || isBothCurrency" class="d-flex justify-content-between flex-grow-1">
                        <span class="label pe-2"><t t-if="isOnlyKHR">Change (KHR)</t><t t-else="">+ (KHR)</t></span>
                        <span class="amount align-self-end pe-5" t-att-class="{ 'highlight text-success fw-bolder': props.order.get_change() > 0 }">
                            <t t-esc="changeTextkhr" />
                        </span>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
