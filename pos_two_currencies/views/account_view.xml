<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_account_tax_form_inherit" model="ir.ui.view">
            <field name="name">account.tax.form</field>
            <field name="model">account.tax</field>
            <field name="inherit_id" ref="account.view_tax_form"/>
            <field name="arch" type="xml">
                <field name="price_include" position="after">
                    <field name="is_discount_vat"/>
                    <field name="discount_account_id" required="is_discount_vat" invisible="not is_discount_vat"/>
                </field>
            </field>
        </record>
</odoo>