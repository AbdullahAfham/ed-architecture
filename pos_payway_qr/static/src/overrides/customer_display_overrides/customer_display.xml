                                    </div>
                                    <div class="khqr-header" style="text-align: start; margin-top: -4px; padding: 0px 24px 8px 24px;">
                                        <div class="normal-text"><t t-esc="order.payWayPaymentData.store" /> </div>
                                        <div class="amount-text"><t t-esc="order.payWayPaymentData.amount" />
                                            <span class="currency-text"> <t t-if="order.payWayPaymentData.isKHR">KHR</t><t t-else="">USD</t></span>
                                        </div>
                                    </div>
                                    <div style="position: relative;padding: 12px 0;">
                                        <div style="position: absolute;max-width: 18%;top: 41%;left: 41%;max-height: 18%;">
                                            <t t-if="order.payWayPaymentData.isKHR"> <!-- USD/KHR Symbol -->
                                                <img style="width: 100%;height: 100%;" alt="KHR" src="data:image/png;base64," />
                                            </t>
                                            <t t-else="">
                                                <img style="width: 100%;height: 100%;" alt="USD" src="data:image/png;base64," />
                                            </t>
                                        </div>
                                        <img style="width: 25vh; height: 25vh; max-width: 100%; min-width: 100px; min-height: 100px;" t-att-src="order.payWayPaymentData.qrImage" alt="Logo"/>
                                    </div>
                                </div>

                                <div class="footer-text">
                                    Scan with ABA Mobile, or other Mobile Banking App supporting KHQR
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>
