<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_payway_qr.CustomerDisplay" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//div[@t-if='order.amount and !order.finalized']" position="replace">
                <div t-if="order.amount and !order.finalized" class="py-3 px-4 bg-view border-top">
                    <div class="d-flex flex-column justify-content-center gap-1 w-100 w-sm-50 ms-auto">
                        <div class="row fs-2 fw-bolder">
                            <div class="col text-end">Total (USD)</div>
                            <div class="col text-end" t-esc="order.amount"/>
                        </div>
                        <div class="row fs-5 fw-bolder">
                            <div class="col text-end">(KHR)</div>
                            <div class="col text-end" t-esc="order.amountKHR"/>
                        </div>
                        <div t-foreach="order.paymentLines or []" t-as="line" t-key="line_index" class="row">
                            <div class="col text-end" t-esc="line.name" />
                            <div class="col text-end" t-esc="line.amount"/>
                        </div>
                        <div class="row" t-if="order.changeUSD">
                            <div class="col text-end">Change</div>
                            <div class="col text-end" t-esc="order.changeUSD"/>
                        </div>
                        <div class="row" t-if="order.changeKHR">
                            <div class="col text-end">+ (KHR)</div>
                            <div class="col text-end" t-esc="order.changeKHR"/>
                        </div>
                    </div>
                </div>
        </xpath>
        <xpath expr="//div[hasclass('o_customer_display')]" position="inside">
            <div t-if="order.payWayPaymentData?.store" class="popups aba-dialog">
