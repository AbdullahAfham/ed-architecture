<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_method_view_form_inherit_pos_payway" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.payway</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="payway_qr_merchant_id" invisible="use_payment_terminal != 'payway_qr'" required="use_payment_terminal == 'payway_qr'"/>
                <field name="payway_qr_key" invisible="use_payment_terminal != 'payway_qr'" required="use_payment_terminal == 'payway_qr'"/>
                <field name="payway_qr_test_mode" invisible="use_payment_terminal != 'payway_qr'" required="use_payment_terminal == 'payway_qr'"/>
                <field name="payway_currency_id" invisible="use_payment_terminal != 'payway_qr'" required="use_payment_terminal == 'payway_qr'"/>
                <field name="payway_qr_webhook_endpoint" widget="url" invisible="use_payment_terminal != 'payway_qr'" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
